{% comment %}
  EyeNova Qatar - Clean Minimalist Product Card (Parity with Home Page)
{% endcomment %}

<div class="nextjs-product-card">
  <a href="{{ product.url }}" class="nextjs-product-link">
    <div class="product-image-box">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | image_url: width: 500 }}" 
          alt="{{ product.title | escape }}"
          width="500"
          height="500"
          loading="lazy"
        >
      {% else %}
        <div class="image-placeholder-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
      {% endif %}
    </div>
    <h3 class="product-card-title">{{ product.title }}</h3>
    <span class="product-card-price">{{ product.price | money }}</span>
  </a>
</div>
