{% comment %}
  EyeNova Qatar — Luxury Product Card
{% endcomment %}

<div class="product-card">
  <div style="position: relative; overflow: hidden;">
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" 
        alt="{{ product.title | escape }}"
        class="product-card-image"
        loading="lazy"
      >
    {% else %}
      <div class="product-card-image" style="display: flex; align-items: center; justify-content: center; color: var(--color-muted); font-size: 0.85rem;">
        EyeNova Luxury Frame
      </div>
    {% endif %}

    <!-- Luxury Tag Badge -->
    <div style="position: absolute; top: 12px; left: 12px; background: rgba(20, 11, 26, 0.85); backdrop-filter: blur(4px); color: var(--color-accent); font-size: 0.7rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px; letter-spacing: 0.05em; border: 1px solid rgba(223, 183, 108, 0.3);">
      Qatar Exclusive
    </div>
  </div>

  <div class="product-card-info">
    <div style="font-size: 0.75rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">
      {{ product.vendor | default: "EyeNova Atelier" }}
    </div>

    <h3 class="product-card-title">
      <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
        {{ product.title }}
      </a>
    </h3>

    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-top: 1rem;">
      <span class="product-card-price">
        {{ product.price | money_without_trailing_zeros }} {{ 'general.currency' | t }}
      </span>

      <a href="{{ product.url }}" class="btn btn-outline" style="padding: 0.45rem 0.9rem; font-size: 0.8rem;">
        {{ 'general.view_all' | t }}
      </a>
    </div>
  </div>
</div>
