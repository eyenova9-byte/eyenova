{% comment %}
  EyeNova Qatar — Slide-out AJAX Cart Drawer
{% endcomment %}

<div id="cart-drawer-overlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>

<div id="cart-drawer" style="position: fixed; top: 0; right: 0; width: 100%; max-width: 440px; height: 100%; background: #ffffff; z-index: 999; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: -10px 0 30px rgba(0,0,0,0.15); display: flex; flex-direction: column;">
  
  <div style="padding: 1.5rem; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
    <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.3rem;">
      {{ 'cart.title' | t }}
    </h3>
    <button data-cart-close style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--color-muted);">&times;</button>
  </div>

  <div style="padding: 1.5rem; flex-grow: 1; overflow-y: auto;">
    {% if cart.item_count > 0 %}
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border);">
            <img src="{{ item.image | img_url: '120x120', crop: 'center' }}" alt="{{ item.title }}" style="width: 75px; height: 75px; object-fit: cover; border-radius: 6px;">
            <div style="flex-grow: 1;">
              <h4 style="font-size: 0.95rem; margin-bottom: 0.25rem;">{{ item.product.title }}</h4>
              <p style="font-size: 0.85rem; color: var(--color-primary); font-weight: 700;">
                {{ item.final_line_price | money_without_trailing_zeros }} {{ 'general.currency' | t }}
              </p>

              <!-- Display Attached Optical Line Properties -->
              {% if item.properties.size > 0 %}
                <div style="font-size: 0.75rem; color: var(--color-muted); margin-top: 0.35rem; background: #fdfbf7; padding: 0.35rem 0.5rem; border-radius: 4px;">
                  {% for prop in item.properties %}
                    <div><strong>{{ prop.first }}:</strong> {{ prop.last }}</div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 4rem 1rem; color: var(--color-muted);">
        <p style="font-size: 1.1rem; margin-bottom: 1.5rem;">{{ 'general.empty_cart' | t }}</p>
        <a href="/collections/all" class="btn btn-outline" data-cart-close>
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div style="padding: 1.5rem; border-top: 1px solid var(--color-border); background: #fcfbfa;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 1.1rem; font-weight: 700;">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span style="color: var(--color-primary);">{{ cart.total_price | money_without_trailing_zeros }} {{ 'general.currency' | t }}</span>
      </div>
      <p style="font-size: 0.78rem; color: var(--color-muted); margin-bottom: 1.25rem;">
        {{ 'cart.shipping_note' | t }}
      </p>
      <a href="/checkout" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1rem;">
        {{ 'general.checkout' | t }}
      </a>
    </div>
  {% endif %}
</div>

<style>
  #cart-drawer.open {
    transform: translateX(0) !important;
  }
  #cart-drawer.open + #cart-drawer-overlay,
  #cart-drawer.open ~ #cart-drawer-overlay {
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>
