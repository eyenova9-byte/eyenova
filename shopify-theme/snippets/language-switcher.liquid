{% comment %}
  EyeNova Qatar — Bilingual Language Switcher (EN / AR)
{% endcomment %}

<div class="lang-switcher" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600;">
  {% form 'localization', id: 'localization_form', class: 'localization-form' %}
    <input type="hidden" name="locale_code" id="localeCode" value="{{ localization.language.iso_code }}">
    
    <div style="display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: 9999px; padding: 2px; background: #ffffff;">
      <button 
        type="submit" 
        onclick="document.getElementById('localeCode').value='en'"
        style="padding: 0.25rem 0.65rem; border-radius: 9999px; border: none; cursor: pointer; background: {% if localization.language.iso_code == 'en' %}var(--color-primary){% else %}transparent{% endif %}; color: {% if localization.language.iso_code == 'en' %}#ffffff{% else %}var(--color-text){% endif %}; font-weight: 600; font-size: 0.78rem;"
      >
        EN
      </button>

      <button 
        type="submit" 
        onclick="document.getElementById('localeCode').value='ar'"
        style="padding: 0.25rem 0.65rem; border-radius: 9999px; border: none; cursor: pointer; background: {% if localization.language.iso_code == 'ar' %}var(--color-primary){% else %}transparent{% endif %}; color: {% if localization.language.iso_code == 'ar' %}#ffffff{% else %}var(--color-text){% endif %}; font-weight: 600; font-size: 0.78rem;"
      >
        العربية
      </button>
    </div>
  {% endform %}
</div>
