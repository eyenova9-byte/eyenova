{% comment %}
  EyeNova Qatar - Exact Bilingual Language Switcher matching Next.js Navbar pill
{% endcomment %}

<div class="nextjs-lang-switch-wrap">
  {% form 'localization', id: 'localization_form', class: 'localization-form' %}
    <input type="hidden" name="locale_code" id="localeCode" value="{{ localization.language.iso_code }}">
    
    <button 
      type="submit" 
      onclick="document.getElementById('localeCode').value='{% if localization.language.iso_code == 'en' %}ar{% else %}en{% endif %}'"
      class="nav-lang-btn"
      aria-label="Toggle language"
    >
      {% if localization.language.iso_code == 'en' %}
        العربية
      {% else %}
        EN
      {% endif %}
    </button>
  {% endform %}
</div>
