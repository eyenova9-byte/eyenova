<section class="optical-services-section" style="background: #ffffff; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 5rem 2rem;">
  <div style="max-width: 1360px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 4rem;">
      <span style="color: var(--color-accent); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">
        Optical Excellence
      </span>
      <h2 style="font-size: clamp(2rem, 3.5vw, 2.75rem); margin-top: 0.5rem; margin-bottom: 1rem;">
        {{ section.settings.heading | default: "The EyeNova Experience" }}
      </h2>
      <p style="color: var(--color-muted); max-width: 600px; margin: 0 auto; font-size: 1rem;">
        Uncompromising precision tailored for the distinguished clientele of Qatar.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem;">
      <!-- Service 1 -->
      <div style="background: #fdfbf7; border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; text-align: center;">
        <div style="width: 60px; height: 60px; margin: 0 auto 1.25rem; background: rgba(92, 45, 118, 0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--color-primary);">Bespoke Lens Technology</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
          High-index Japanese and German ophthalmic lenses with anti-reflective, scratch-resistant, and UV400 coatings.
        </p>
      </div>

      <!-- Service 2 -->
      <div style="background: #fdfbf7; border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; text-align: center;">
        <div style="width: 60px; height: 60px; margin: 0 auto 1.25rem; background: rgba(223, 183, 108, 0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-accent);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--color-primary);">Doha Concierge Service</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
          Complimentary direct delivery across Doha, Lusail, and Al Wakrah with customized white-glove packaging.
        </p>
      </div>

      <!-- Service 3 -->
      <div style="background: #fdfbf7; border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; text-align: center;">
        <div style="width: 60px; height: 60px; margin: 0 auto 1.25rem; background: rgba(92, 45, 118, 0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--color-primary);">PCI-DSS Bank Grade Security</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
          Shopify Level 1 PCI-compliant checkout supporting Apple Pay, Tap Payments, and Qatar NAPS debit cards.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Optical Services",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The EyeNova Experience"
    }
  ],
  "presets": [
    {
      "name": "Optical Services"
    }
  ]
}
{% endschema %}
