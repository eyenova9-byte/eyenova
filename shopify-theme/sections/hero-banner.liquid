<section class="eyenova-hero-section">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left Column: Content -->
      <div class="hero-content">
        <!-- Badge -->
        <div class="hero-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          <span>Qatar's Premier Optical Boutique</span>
        </div>

        <!-- Heading -->
        <h1 class="hero-title">
          Clear Vision, <br class="hero-br">
          <span class="hero-title-highlight">Timeless Optical Style</span>
        </h1>

        <!-- Subheading -->
        <p class="hero-subtitle">
          Discover certified medical contact lenses, trend-setting colored lenses, and eye care essentials with same-day express delivery across Qatar.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta-group">
          <a href="/collections/all?category=medical" class="hero-btn-primary">
            <span>Explore Medical Lenses</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/collections/all?category=colored" class="hero-btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Colour Collections</span>
          </a>
        </div>

        <!-- Trust Micro-Badges -->
        <div class="hero-trust-badges">
          <div class="trust-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>MOPH Qatar Approved</span>
          </div>
          <div class="trust-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>Same-Day Delivery</span>
          </div>
          <div class="trust-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>100% Authentic</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Feature Card -->
      <div class="hero-feature-wrapper">
        <div class="hero-feature-card">
          <div class="feature-image-container">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop" alt="EyeNova Qatar Optical" loading="eager" width="600" height="450">
            <div class="floating-badge-left">New Arrival</div>
            <div class="floating-badge-right">Qatar #1 Optical Store</div>
          </div>
          <div class="feature-card-footer">
            <div>
              <h3 class="feature-card-title">Bella & Amara Luxury Shades</h3>
              <p class="feature-card-sub">Available in Plano & Prescription</p>
            </div>
            <a href="/collections/all?category=colored" class="feature-card-link">
              <span>View</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
