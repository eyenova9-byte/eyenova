<section class="hero-section" style="position: relative; padding: 6rem 2rem; background: linear-gradient(135deg, #fdfbf7 0%, #f4eff7 100%); border-bottom: 1px solid var(--color-border); overflow: hidden;">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 4rem; align-items: center;">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(92, 45, 118, 0.08); border: 1px solid rgba(92, 45, 118, 0.2); padding: 0.35rem 0.9rem; border-radius: 9999px; margin-bottom: 1.5rem;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent);"></span>
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary); letter-spacing: 0.08em; text-transform: uppercase;">
          {{ section.settings.badge_text | default: "The Qatar Optical Atelier" }}
        </span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; line-height: 1.1; margin-bottom: 1.25rem; color: var(--color-primary);">
        {{ section.settings.heading | default: "Elevate Your Vision With Luxury Eyewear" }}
      </h1>

      <p style="font-size: 1.15rem; color: var(--color-muted); max-width: 520px; margin-bottom: 2.25rem; line-height: 1.7;">
        {{ section.settings.subheading | default: "Exquisite craftsmanship, bespoke optical lenses, and international designer eyewear curated exclusively for Qatar." }}
      </p>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary">
          {{ section.settings.button_text | default: "Explore Eyewear" }}
        </a>
        <a href="https://wa.me/97455123456" target="_blank" class="btn btn-gold">
          {{ 'products.whatsapp_inquire' | t }}
        </a>
      </div>
    </div>

    <!-- Hero Visual / Graphic Presentation -->
    <div style="position: relative;">
      <div style="background: #ffffff; border-radius: 20px; padding: 2.5rem; box-shadow: var(--shadow-luxury); border: 1px solid var(--color-border); text-align: center;">
        <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(92, 45, 118, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
          {% render 'icon-eye-logo' %}
        </div>
        <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--color-primary);">Bespoke Qatar Service</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); margin-bottom: 1.5rem;">
          Prescription lenses precision-calibrated in Doha with home fitting and complimentary styling consultation.
        </p>
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.05em; text-transform: uppercase;">
          Opening Soon Across Qatar
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "The Qatar Optical Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Elevate Your Vision With Luxury Eyewear"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Exquisite craftsmanship, bespoke optical lenses, and international designer eyewear curated exclusively for Qatar."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Eyewear"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
