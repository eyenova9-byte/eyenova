{% comment %}
  EyeNova Qatar - Exact Footer matching Next.js Footer component (www.eyenova.com.qa)
{% endcomment %}

<style>
  .nextjs-site-footer {
    background-color: #FAF5F2 !important;
    color: #121212 !important;
    border-top: 1px solid #EBE0DA !important;
    font-family: inherit !important;
  }

  /* 1. Value Props Strip */
  .footer-value-props-strip {
    border-bottom: 1px solid #EBE0DA !important;
    padding: 2rem 1rem !important;
  }

  @media (min-width: 640px) {
    .footer-value-props-strip {
      padding: 2rem 1.5rem !important;
    }
  }

  @media (min-width: 1024px) {
    .footer-value-props-strip {
      padding: 2rem 2rem !important;
    }
  }

  .footer-props-grid {
    max-width: 1280px !important;
    margin: 0 auto !important;
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1.5rem !important;
    text-align: center !important;
  }

  @media (min-width: 768px) {
    .footer-props-grid {
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }

  .footer-prop-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  .footer-prop-icon-box {
    width: 2.5rem !important;
    height: 2.5rem !important;
    border-radius: 9999px !important;
    background-color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #5c2d76 !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
    margin-bottom: 0.625rem !important;
  }

  .footer-prop-title {
    font-size: 13px !important;
    font-weight: 600 !important;
    color: #121212 !important;
  }

  @media (min-width: 640px) {
    .footer-prop-title {
      font-size: 14px !important;
    }
  }

  .footer-prop-sub {
    font-size: 11px !important;
    color: #707070 !important;
    margin-top: 0.125rem !important;
  }

  @media (min-width: 640px) {
    .footer-prop-sub {
      font-size: 12px !important;
    }
  }

  /* 2. Main Multi-Column Body */
  .footer-main-container {
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 3rem 1rem 2.5rem 1rem !important;
  }

  @media (min-width: 640px) {
    .footer-main-container {
      padding: 3rem 1.5rem 2.5rem 1.5rem !important;
    }
  }

  @media (min-width: 1024px) {
    .footer-main-container {
      padding: 3rem 2rem 2.5rem 2rem !important;
    }
  }

  .footer-columns-grid {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 2rem !important;
  }

  @media (min-width: 768px) {
    .footer-columns-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (min-width: 1024px) {
    .footer-columns-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr !important;
      gap: 2.5rem !important;
    }
  }

  .footer-brand-column {
    display: flex !important;
    flex-direction: column !important;
    gap: 1rem !important;
  }

  .footer-desc-text {
    font-size: 13px !important;
    color: #555555 !important;
    line-height: 1.625 !important;
    max-width: 28rem !important;
  }

  .footer-contact-pills {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 0.5rem !important;
    padding-top: 0.25rem !important;
  }

  .footer-wa-pill {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.375rem !important;
    background-color: #25D366 !important;
    color: #FFFFFF !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    padding: 0.25rem 0.75rem !important;
    border-radius: 9999px !important;
    text-decoration: none !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
    transition: background-color 0.15s ease !important;
  }

  .footer-wa-pill:hover {
    background-color: #20BA59 !important;
  }

  .footer-email-pill {
    font-size: 12px !important;
    color: #555555 !important;
    background-color: #FFFFFF !important;
    border: 1px solid #E8DED8 !important;
    padding: 0.25rem 0.75rem !important;
    border-radius: 9999px !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
    transition: color 0.15s ease !important;
  }

  .footer-email-pill:hover {
    color: #5c2d76 !important;
  }

  .footer-col-heading {
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #121212 !important;
    margin-bottom: 0.875rem !important;
    letter-spacing: 0.025em !important;
  }

  .footer-links-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
  }

  .footer-link-anchor {
    font-size: 13px !important;
    color: #555555 !important;
    text-decoration: none !important;
    transition: color 0.15s ease !important;
  }

  .footer-link-anchor:hover {
    color: #5c2d76 !important;
  }

  /* 3. Newsletter Section */
  .footer-newsletter-row {
    margin-top: 3rem !important;
    padding-top: 2rem !important;
    border-top: 1px solid #EBE0DA !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 1.5rem !important;
  }

  @media (min-width: 768px) {
    .footer-newsletter-row {
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
    }
  }

  .footer-news-left {
    width: 100% !important;
    max-width: 28rem !important;
  }

  .footer-news-title {
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #121212 !important;
    margin-bottom: 0.25rem !important;
  }

  .footer-news-sub {
    font-size: 12px !important;
    color: #707070 !important;
    margin-bottom: 0.75rem !important;
  }

  .footer-news-form {
    display: flex !important;
    gap: 0.5rem !important;
  }

  .footer-news-input {
    flex: 1 !important;
    background-color: #FFFFFF !important;
    border: 1px solid #D5C7BF !important;
    padding: 0.5rem 0.875rem !important;
    font-size: 13px !important;
    color: #121212 !important;
    border-radius: 0.375rem !important;
    outline: none !important;
  }

  .footer-news-input:focus {
    border-color: #5c2d76 !important;
  }

  .footer-news-btn {
    background-color: #5c2d76 !important;
    color: #FFFFFF !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    padding: 0.5rem 1rem !important;
    border-radius: 0.375rem !important;
    border: none !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease !important;
  }

  .footer-news-btn:hover {
    background-color: #4a245f !important;
  }

  /* Social Icons */
  .footer-social-row {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
  }

  .footer-social-circle {
    width: 2.25rem !important;
    height: 2.25rem !important;
    border-radius: 9999px !important;
    background-color: #FFFFFF !important;
    border: 1px solid #D5C7BF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #121212 !important;
    text-decoration: none !important;
    transition: color 0.15s ease, border-color 0.15s ease !important;
  }

  .footer-social-circle:hover {
    color: #5c2d76 !important;
    border-color: #5c2d76 !important;
  }

  /* 4. Bottom Row: Copyright & Qatar Payment Badges */
  .footer-bottom-bar {
    margin-top: 2rem !important;
    padding-top: 1.5rem !important;
    border-top: 1px solid #EBE0DA !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem !important;
    font-size: 12px !important;
    color: #707070 !important;
  }

  @media (min-width: 768px) {
    .footer-bottom-bar {
      flex-direction: row !important;
    }
  }

  .footer-bottom-left {
    display: flex !important;
    align-items: center !important;
    gap: 1rem !important;
  }

  .footer-pay-badges {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 0.375rem !important;
  }

  .pay-badge-box {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background-color: #FFFFFF !important;
    border: 1px solid #D5C7BF !important;
    padding: 0.125rem 0.5rem !important;
    border-radius: 0.25rem !important;
    height: 1.5rem !important;
    font-size: 9px !important;
    font-weight: 700 !important;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.02) !important;
  }
</style>

<footer class="nextjs-site-footer">
  <!-- 1. Value Props Strip -->
  <div class="footer-value-props-strip">
    <div class="footer-props-grid">
      <div class="footer-prop-item">
        <div class="footer-prop-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <h4 class="footer-prop-title">Same-Day Delivery</h4>
        <p class="footer-prop-sub">Across Doha &amp; all Qatar</p>
      </div>

      <div class="footer-prop-item">
        <div class="footer-prop-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h4 class="footer-prop-title">100% Authentic</h4>
        <p class="footer-prop-sub">MOPH Qatar Approved</p>
      </div>

      <div class="footer-prop-item">
        <div class="footer-prop-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h4 class="footer-prop-title">24/7 Support</h4>
        <p class="footer-prop-sub">Instant WhatsApp concierge</p>
      </div>

      <div class="footer-prop-item">
        <div class="footer-prop-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
          </svg>
        </div>
        <h4 class="footer-prop-title">Opening Soon in Qatar</h4>
        <p class="footer-prop-sub">Premier luxury optical destination</p>
      </div>
    </div>
  </div>

  <!-- 2. Main 4-Column Footer Grid -->
  <div class="footer-main-container">
    <div class="footer-columns-grid">
      <!-- Brand Info & Vision -->
      <div class="footer-brand-column">
        {% render 'brand-logo', size: 'lg', variant: 'dark', with_text: true, show_arabic: true %}
        <p class="footer-desc-text">
          EyeNova is Qatar's premier optical store for certified medical &amp; colored contact lenses, luxury eyewear, and vision care products. Authorized retailer for world-leading eye care brands.
        </p>
        <div class="footer-contact-pills">
          <a href="https://wa.me/97455123456" target="_blank" rel="noopener noreferrer" class="footer-wa-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span>+974 5512 3456</span>
          </a>
          <a href="mailto:support@eyenova.com.qa" class="footer-email-pill">
            <span style="font-weight: 600; color: #121212;">Support:</span> support@eyenova.com.qa
          </a>
          <a href="mailto:info@eyenova.com.qa" class="footer-email-pill">
            <span style="font-weight: 600; color: #121212;">Info:</span> info@eyenova.com.qa
          </a>
        </div>
      </div>

      <!-- Quick Categories -->
      <div>
        <h3 class="footer-col-heading">Products</h3>
        <ul class="footer-links-list">
          <li><a href="/collections/all?type=daily" class="footer-link-anchor">Daily Contact Lenses</a></li>
          <li><a href="/collections/all?type=monthly" class="footer-link-anchor">Monthly Contact Lenses</a></li>
          <li><a href="/collections/all?category=colored" class="footer-link-anchor">Colored Lenses</a></li>
          <li><a href="/collections/all?category=solutions" class="footer-link-anchor">Lens Solutions &amp; Drops</a></li>
          <li><a href="/collections/all?category=lashes" class="footer-link-anchor">Lashes &amp; Accessories</a></li>
        </ul>
      </div>

      <!-- Top Brands -->
      <div>
        <h3 class="footer-col-heading">Top Brands</h3>
        <ul class="footer-links-list">
          <li><a href="/collections/all?brand=acuvue" class="footer-link-anchor">Acuvue (Johnson &amp; Johnson)</a></li>
          <li><a href="/collections/all?brand=alcon" class="footer-link-anchor">Alcon Dailies &amp; Air Optix</a></li>
          <li><a href="/collections/all?brand=bella" class="footer-link-anchor">Bella Contact Lenses</a></li>
          <li><a href="/collections/all?brand=amara" class="footer-link-anchor">Amara Celebrity Shades</a></li>
          <li><a href="/collections/all?brand=lensme" class="footer-link-anchor">LensMe Korea Collection</a></li>
        </ul>
      </div>

      <!-- Customer Care & Policies -->
      <div>
        <h3 class="footer-col-heading">Customer Care</h3>
        <ul class="footer-links-list">
          <li><a href="/pages/terms" class="footer-link-anchor">Terms of Service</a></li>
          <li><a href="/pages/privacy" class="footer-link-anchor">Privacy Policy</a></li>
          <li><a href="/pages/refund-policy" class="footer-link-anchor">Refund Policy</a></li>
          <li><a href="/pages/about" class="footer-link-anchor">About EyeNova</a></li>
        </ul>
      </div>
    </div>

    <!-- 3. Newsletter Section & Socials -->
    <div class="footer-newsletter-row">
      <div class="footer-news-left">
        <h4 class="footer-news-title">Subscribe for Exclusive Offers</h4>
        <p class="footer-news-sub">Get 10% off your next order &amp; updates on newest lens arrivals.</p>
        {% form 'customer', class: 'footer-news-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="name@example.com" required class="footer-news-input">
          <button type="submit" class="footer-news-btn">Subscribe</button>
        {% endform %}
      </div>

      <!-- Social Links -->
      <div class="footer-social-row">
        <a href="https://www.instagram.com/eyenova_qa" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-circle">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://www.tiktok.com/@eyenova_qa" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="footer-social-circle">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.77 1.81-.02 3.32-1.5 3.37-3.31.05-3.88.02-7.77.03-11.66.01-2.12-.01-4.24.02-6.36z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 4. Bottom Row: Copyright & Qatar Payment Methods -->
    <div class="footer-bottom-bar">
      <div class="footer-bottom-left">
        <span>&copy; {{ 'now' | date: '%Y' }} EyeNova Qatar. All rights reserved.</span>
        <span>&bull;</span>
        <span>Licensed by Qatar MOPH</span>
      </div>

      <div class="footer-pay-badges">
        <span class="pay-badge-box" style="color: #006FCF;">AMEX</span>
        <span class="pay-badge-box" style="color: #121212;">Pay</span>
        <span class="pay-badge-box" style="color: #8A1538;">QPay</span>
        <span class="pay-badge-box" style="color: #005B94;">mada</span>
        <span class="pay-badge-box" style="color: #E41E26;">NAPS</span>
        <span class="pay-badge-box" style="color: #1A1F71; font-style: italic;">VISA</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
