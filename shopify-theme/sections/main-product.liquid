<section class="main-product-section" data-reveal style="padding: 2rem 1.5rem; max-width: 1280px; margin: 0 auto;">
  <div class="product-layout-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">

    <!-- Product Gallery -->
    <div class="product-gallery">
      <div class="product-gallery-main" style="background: #ffffff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1rem; box-shadow: var(--shadow-sm);">
        {% if product.featured_image %}
          <img id="ProductMainImage" src="{{ product.featured_image | img_url: '800x800', crop: 'center' }}" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block;">
        {% else %}
          <div style="height: 450px; background: #fdfbf7; display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-primary);">
            EyeNova Frame Gallery
          </div>
        {% endif %}
      </div>

      <!-- Thumbnails -->
      {% if product.images.size > 1 %}
        <div class="product-thumb-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
          {% for img in product.images %}
            <button type="button" class="product-thumb{% if forloop.first %} is-active{% endif %}" data-full="{{ img | img_url: '800x800', crop: 'center' }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | img_url: '200x200', crop: 'center' }}" alt="{{ product.title | escape }} thumbnail {{ forloop.index }}" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info & Optical Customizer Form -->
    <div>
      <div style="font-size: 0.8rem; color: var(--color-accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
        {{ product.vendor | default: "EyeNova Qatar" }}
      </div>

      <h1 style="font-size: clamp(2rem, 3.5vw, 2.75rem); margin-bottom: 0.75rem; color: var(--color-primary);">
        {{ product.title }}
      </h1>

      <div style="font-size: 1.6rem; font-weight: 700; color: var(--color-primary); margin-bottom: 1.5rem;">
        {{ product.price | money_without_trailing_zeros }} {{ 'general.currency' | t }}
      </div>

      <div style="font-size: 0.95rem; color: var(--color-muted); line-height: 1.8; margin-bottom: 2rem;">
        {{ product.description }}
      </div>

      {% form 'product', product, id: 'AddToCartForm', class: 'product-form' %}
        <!-- Variant Selection (e.g. Power / SPH for Contact Lenses) -->
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% else %}
          <div style="margin-bottom: 1.5rem; background: #ffffff; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 8px;">
            {% for option in product.options_with_values %}
              <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem; text-transform: uppercase;">
                {{ option.name }}:
              </label>
              <select name="id" id="SingleOptionSelector-{{ forloop.index0 }}" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.95rem; font-weight: 600; background: #ffffff;">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %} {% unless variant.available %}disabled="disabled"{% endunless %}>
                    {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }} {{ 'general.currency' | t }}
                  </option>
                {% endfor %}
              </select>
            {% endfor %}
          </div>
        {% endif %}

        <!-- If Contact Lenses: Option to specify two different box powers (OD Right & OS Left) -->
        {% if product.type contains 'Contact Lens' or product.tags contains 'contact-lenses' %}
          <div style="background: #fdfbf7; border: 1px solid rgba(223, 183, 108, 0.4); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <strong style="color: var(--color-primary); font-size: 0.95rem;">Differing Eye Prescriptions?</strong>
              <span style="font-size: 0.75rem; color: var(--color-accent); font-weight: 700; text-transform: uppercase;">Optional Dual-Power Note</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--color-muted); margin-bottom: 0.75rem;">
              If your right and left eyes require different powers, specify below or leave blank to use the selected power above.
            </p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
              <input type="text" name="properties[Right Eye Power (OD)]" placeholder="Right Eye (e.g. -2.00)" style="padding: 0.6rem; border: 1px solid var(--color-border); border-radius: 4px; font-size: 0.85rem;">
              <input type="text" name="properties[Left Eye Power (OS)]" placeholder="Left Eye (e.g. -2.50)" style="padding: 0.6rem; border: 1px solid var(--color-border); border-radius: 4px; font-size: 0.85rem;">
            </div>
          </div>
        {% endif %}

        <!-- If Eyeglasses / Optical Frames: Show Lens Customizer (Single Vision, Progressive, Blue Light) -->
        {% if product.type contains 'Eyeglasses' or product.type contains 'Optical' or product.tags contains 'eyeglasses' %}
          {% render 'prescription-options' %}
        {% endif %}

        <!-- Quantity & Add to Cart -->
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <input type="number" name="quantity" value="1" min="1" style="width: 70px; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 6px; font-weight: 700; text-align: center;">
          
          <button type="submit" class="btn btn-primary" style="flex-grow: 1; padding: 1rem;">
            {{ 'products.add_to_cart' | t }}
          </button>
        </div>
      {% endform %}


      <!-- WhatsApp Concierge Support -->
      <div style="margin-top: 1.5rem; text-align: center;">
        <a href="https://wa.me/97455123456?text=Hello%20EyeNova%20Qatar,%20I%20would%20like%20to%20inquire%20about%20{{ product.title | url_encode }}" target="_blank" class="btn btn-outline" style="width: 100%; padding: 0.85rem;">
          {{ 'products.whatsapp_inquire' | t }}
        </a>
      </div>

      <!-- Specifications Box -->
      <div style="margin-top: 2.5rem; padding: 1.5rem; background: #ffffff; border: 1px solid var(--color-border); border-radius: 8px;">
        <h4 style="font-family: var(--font-serif); font-size: 1.1rem; color: var(--color-primary); margin-bottom: 1rem;">
          {{ 'products.frame_details' | t }}
        </h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.85rem;">
          <div><strong style="color: var(--color-muted);">Material:</strong> Premium Mazzucchelli Acetate</div>
          <div><strong style="color: var(--color-muted);">Hinges:</strong> 5-Barrel Precision German Steel</div>
          <div><strong style="color: var(--color-muted);">UV Protection:</strong> 100% UVA/UVB Filter</div>
          <div><strong style="color: var(--color-muted);">Origin:</strong> Designed for Doha, Qatar</div>
        </div>
      </div>

    </div>

  </div>
</section>

  <!-- Related Products / Recommended Lenses (Exact Home Page Card Parity) -->
  <section class="store-section" style="border-top: 1px solid #E5E7EB; margin-top: 2rem; padding-top: 1.5rem; width: 100%;">
    <div class="store-container">
      <div class="section-title-row">
        <h2 class="section-title-text">You May Also Like</h2>
        <a href="/collections/all" class="section-link-more">View all &rarr;</a>
      </div>

      <div class="nextjs-products-grid">
        <!-- 1. 1 Day Acuvue Moist -->
        <div class="nextjs-product-card">
          <a href="/collections/all?brand=acuvue" class="nextjs-product-link">
            <div class="product-image-box">
              <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="1 Day Acuvue Moist" loading="lazy">
            </div>
            <h3 class="product-card-title">1 Day Acuvue Moist 30 Pack</h3>
            <span class="product-card-price">QAR 159.00</span>
          </a>
        </div>

        <!-- 2. Bella Diamond Gray Shadow -->
        <div class="nextjs-product-card">
          <a href="/collections/all?brand=bella" class="nextjs-product-link">
            <div class="product-image-box">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop" alt="Bella Diamond Gray Shadow" loading="lazy">
            </div>
            <h3 class="product-card-title">Bella Diamond Gray Shadow</h3>
            <span class="product-card-price">QAR 130.00</span>
          </a>
        </div>

        <!-- 3. Acuvue Oasys with HydraLuxe -->
        <div class="nextjs-product-card">
          <a href="/collections/all?brand=acuvue" class="nextjs-product-link">
            <div class="product-image-box">
              <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="Acuvue Oasys 1 DAY with HydraLuxe" loading="lazy">
            </div>
            <h3 class="product-card-title">Acuvue Oasys 1 DAY with HydraLuxe</h3>
            <span class="product-card-price">QAR 195.00</span>
          </a>
        </div>

        <!-- 4. Lensme Caramel Golden Hazel -->
        <div class="nextjs-product-card">
          <a href="/collections/all?brand=lensme" class="nextjs-product-link">
            <div class="product-image-box">
              <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500&auto=format&fit=crop" alt="Lensme Caramel Golden Hazel" loading="lazy">
            </div>
            <h3 class="product-card-title">Lensme Caramel Golden Hazel</h3>
            <span class="product-card-price">QAR 145.00</span>
          </a>
        </div>

        <!-- 5. Dailies Total 1 -->
        <div class="nextjs-product-card">
          <a href="/collections/all?brand=alcon" class="nextjs-product-link">
            <div class="product-image-box">
              <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="Dailies Total 1" loading="lazy">
            </div>
            <h3 class="product-card-title">Dailies Total 1 (30 Lenses)</h3>
            <span class="product-card-price">QAR 225.00</span>
          </a>
        </div>
      </div>
    </div>
  </section>

<script>
  (function () {
    var thumbs = document.querySelectorAll('.product-thumb');
    var mainImg = document.getElementById('ProductMainImage');
    if (!thumbs.length || !mainImg) return;
    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var full = btn.getAttribute('data-full');
        if (!full) return;
        mainImg.style.opacity = '0';
        setTimeout(function () {
          mainImg.src = full;
          mainImg.style.opacity = '1';
        }, 160);
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Information",
  "settings": []
}
{% endschema %}
