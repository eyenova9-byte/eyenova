<style>
  .nextjs-announcement-strip {
    background-color: #FAF5F2 !important;
    border-bottom: 1px solid #EFE5DF !important;
    color: #121212 !important;
    font-size: 12px !important;
    padding: 0.5rem 1rem !important;
    letter-spacing: 0.02em !important;
    width: 100% !important;
    position: relative !important;
    z-index: 510 !important;
    line-height: 1.4 !important;
  }

  @media (min-width: 640px) {
    .nextjs-announcement-strip {
      font-size: 13px !important;
    }
  }

  .announcement-inner {
    max-width: 1280px !important;
    margin: 0 auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem !important;
  }

  .announcement-center-wrap {
    flex: 1 !important;
    text-align: center !important;
  }

  .announcement-main-link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.375rem !important;
    color: #121212 !important;
    text-decoration: none !important;
    transition: color 0.15s ease !important;
  }

  .announcement-main-link:hover {
    color: #5c2d76 !important;
  }

  .announcement-pulse-dot {
    width: 6px !important;
    height: 6px !important;
    border-radius: 9999px !important;
    background-color: #5c2d76 !important;
    animation: announcementPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite !important;
    flex-shrink: 0 !important;
  }

  @keyframes announcementPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.2); }
  }

  .announcement-text-bold {
    font-weight: 500 !important;
  }

  .announcement-arrow {
    font-size: 12px !important;
  }

  .announcement-right-contact {
    display: none !important;
  }

  @media (min-width: 768px) {
    .announcement-right-contact {
      display: flex !important;
      align-items: center !important;
      gap: 1rem !important;
      font-size: 12px !important;
      color: #707070 !important;
    }
  }

  .announcement-wa-link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
    color: #707070 !important;
    text-decoration: none !important;
    transition: color 0.15s ease !important;
  }

  .announcement-wa-link:hover {
    color: #121212 !important;
  }

  .wa-icon-green {
    color: #25D366 !important;
  }
</style>

<div class="nextjs-announcement-strip">
  <div class="announcement-inner">
    <div class="announcement-center-wrap">
      <a href="/collections/all" class="announcement-main-link">
        <span class="announcement-pulse-dot"></span>
        <span class="announcement-text-bold">
          {%- if request.locale.iso_code == 'ar' -%}
            توصيل سريع بنفس اليوم في قطر | كود خصم RETURN10
          {%- else -%}
            Same-Day Delivery in Qatar | Use code RETURN10 for 10% off
          {%- endif -%}
        </span>
        <span class="announcement-arrow">&rarr;</span>
      </a>
    </div>

    <div class="announcement-right-contact">
      <a
        href="https://wa.me/97455123456"
        target="_blank"
        rel="noopener noreferrer"
        class="announcement-wa-link"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="wa-icon-green">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
        </svg>
        <span>+974 5512 3456</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
