<section class="section-container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
  <div class="section-header-flex">
    <div>
      <h2 class="section-heading-clean">{{ section.settings.title | default: "Best Selling Medical Lens" }}</h2>
      <p style="font-size: 0.9rem; color: #666666; margin-top: 0.25rem;">{{ section.settings.subtitle | default: "MOPH Qatar certified daily and monthly contact lenses with same-day express delivery." }}</p>
    </div>
    <a href="/collections/all?category=medical" class="section-link-accent">See more &rarr;</a>
  </div>

  <div class="medical-lens-grid">
    {% assign featured_col = collections[section.settings.collection] %}
    {% if featured_col != blank and featured_col.products.size > 0 %}
      {% for product in featured_col.products limit: section.settings.products_to_show %}
        <div class="medical-lens-card">
          <a href="{{ product.url }}" class="lens-card-img-link">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
            {% else %}
              <div class="lens-card-img-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </div>
            {% endif %}
            <span class="lens-card-badge">Daily Lens</span>
          </a>
          <div class="lens-card-info">
            <span class="lens-card-vendor">{{ product.vendor | default: 'EyeNova Medical' }}</span>
            <h3 class="lens-card-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <div class="lens-card-price">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="lens-card-btn">Choose Power</a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- 5 Curated Medical Lens Products (Exact Next.js Match) -->
      <div class="medical-lens-card">
        <a href="/collections/all" class="lens-card-img-link">
          <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400&auto=format&fit=crop" alt="1-Day Acuvue Moist" loading="lazy">
          <span class="lens-card-badge">Daily Lens</span>
        </a>
        <div class="lens-card-info">
          <span class="lens-card-vendor">Acuvue</span>
          <h3 class="lens-card-title"><a href="/collections/all">1-Day Acuvue Moist 30 Pack</a></h3>
          <div class="lens-card-price">QAR 165.00</div>
          <a href="/collections/all" class="lens-card-btn">Choose Power</a>
        </div>
      </div>

      <div class="medical-lens-card">
        <a href="/collections/all" class="lens-card-img-link">
          <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=400&auto=format&fit=crop" alt="Acuvue Oasys 1-Day HydraLuxe" loading="lazy">
          <span class="lens-card-badge">HydraLuxe</span>
        </a>
        <div class="lens-card-info">
          <span class="lens-card-vendor">Acuvue</span>
          <h3 class="lens-card-title"><a href="/collections/all">Acuvue Oasys 1-Day HydraLuxe</a></h3>
          <div class="lens-card-price">QAR 185.00</div>
          <a href="/collections/all" class="lens-card-btn">Choose Power</a>
        </div>
      </div>

      <div class="medical-lens-card">
        <a href="/collections/all" class="lens-card-img-link">
          <img src="https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=400&auto=format&fit=crop" alt="Alcon Dailies Total 1" loading="lazy">
          <span class="lens-card-badge">Water Gradient</span>
        </a>
        <div class="lens-card-info">
          <span class="lens-card-vendor">Alcon</span>
          <h3 class="lens-card-title"><a href="/collections/all">Alcon Dailies Total 1</a></h3>
          <div class="lens-card-price">QAR 210.00</div>
          <a href="/collections/all" class="lens-card-btn">Choose Power</a>
        </div>
      </div>

      <div class="medical-lens-card">
        <a href="/collections/all" class="lens-card-img-link">
          <img src="https://images.unsplash.com/photo-1591076482161-42ce6da69f67?w=400&auto=format&fit=crop" alt="Dailies AquaComfort Plus" loading="lazy">
          <span class="lens-card-badge">Moisture Lock</span>
        </a>
        <div class="lens-card-info">
          <span class="lens-card-vendor">Alcon</span>
          <h3 class="lens-card-title"><a href="/collections/all">Dailies AquaComfort Plus</a></h3>
          <div class="lens-card-price">QAR 145.00</div>
          <a href="/collections/all" class="lens-card-btn">Choose Power</a>
        </div>
      </div>

      <div class="medical-lens-card">
        <a href="/collections/all" class="lens-card-img-link">
          <img src="https://images.unsplash.com/photo-1607613009820-a29f7bb81c04?w=400&auto=format&fit=crop" alt="Air Optix Plus HydraGlyde" loading="lazy">
          <span class="lens-card-badge">Monthly Lens</span>
        </a>
        <div class="lens-card-info">
          <span class="lens-card-vendor">Alcon</span>
          <h3 class="lens-card-title"><a href="/collections/all">Air Optix Plus HydraGlyde 6-Pack</a></h3>
          <div class="lens-card-price">QAR 195.00</div>
          <a href="/collections/all" class="lens-card-btn">Choose Power</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Medical Lenses Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Selling Medical Lens"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "MOPH Qatar certified daily and monthly contact lenses with same-day express delivery."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Medical Lenses Grid"
    }
  ]
}
{% endschema %}
