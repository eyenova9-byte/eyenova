{% comment %}
  EyeNova Qatar - Exact Header matching Next.js Navbar component (www.eyenova.com.qa)
{% endcomment %}

<style>
  /* ============================================================
     STICKY BLUR HEADER (EXACT NEXT.JS PARITY)
     ============================================================ */
  .site-header.eyenova-navbar-root {
    position: sticky !important;
    top: 0 !important;
    z-index: 500 !important;
    background: rgba(255, 255, 255, 0.95) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    backdrop-filter: blur(12px) !important;
    border-bottom: 1px solid #ECECEC !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    transition: all 0.2s ease !important;
  }

  .eyenova-nav-container {
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 0 0.75rem !important;
    height: 56px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: relative !important;
  }

  @media (min-width: 640px) {
    .eyenova-nav-container {
      padding: 0 1.5rem !important;
      height: 64px !important;
    }
  }

  @media (min-width: 1024px) {
    .eyenova-nav-container {
      padding: 0 2rem !important;
      height: 76px !important;
    }
  }

  /* ---- Mobile Hamburger Button (< 1024px) ---- */
  .nav-mobile-toggle-wrap {
    display: flex !important;
    align-items: center !important;
    z-index: 10 !important;
  }

  @media (min-width: 1024px) {
    .nav-mobile-toggle-wrap {
      display: none !important;
    }
  }

  .nav-hamburger-btn {
    padding: 0.375rem !important;
    margin-left: -0.25rem !important;
    background: transparent !important;
    border: none !important;
    color: #121212 !important;
    border-radius: 0.5rem !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background-color 0.15s ease !important;
  }

  .nav-hamburger-btn:hover {
    background-color: #FAF5F2 !important;
  }

  /* ---- Brand Logo Alignment: Centered on mobile, Left on desktop ---- */
  .nav-brand-slot {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    pointer-events: auto !important;
  }

  @media (min-width: 1024px) {
    .nav-brand-slot {
      position: static !important;
      transform: none !important;
    }
  }

  /* ---- BrandLogo Component Styles ---- */
  .brand-logo-component {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.375rem !important;
    text-decoration: none !important;
    user-select: none !important;
    flex-shrink: 0 !important;
  }

  @media (min-width: 640px) {
    .brand-logo-component {
      gap: 0.5rem !important;
    }
  }

  .brand-logo-svg-wrap {
    position: relative !important;
    width: 2rem !important;
    height: 1.5rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    transition: transform 0.3s ease !important;
  }

  @media (min-width: 640px) {
    .brand-logo-svg-wrap {
      width: 2.25rem !important;
      height: 1.625rem !important;
    }
  }

  .brand-logo-component:hover .brand-logo-svg-wrap {
    transform: scale(1.05) !important;
  }

  .brand-logo-svg {
    width: 100% !important;
    height: 100% !important;
  }

  .brand-logo-text-wrap {
    display: flex !important;
    align-items: baseline !important;
    gap: 0.25rem !important;
    line-height: 1 !important;
  }

  @media (min-width: 640px) {
    .brand-logo-text-wrap {
      gap: 0.375rem !important;
    }
  }

  .brand-logo-title {
    font-size: 16px !important;
    font-weight: 600 !important;
    letter-spacing: -0.025em !important;
    color: #121212 !important;
    transition: opacity 0.2s ease !important;
  }

  @media (min-width: 640px) {
    .brand-logo-title {
      font-size: 18px !important;
    }
  }

  .brand-logo-light {
    font-weight: 300 !important;
    letter-spacing: normal !important;
  }

  .brand-logo-arabic {
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #707070 !important;
    display: none !important;
  }

  @media (min-width: 640px) {
    .brand-logo-arabic {
      display: inline !important;
      font-size: 13px !important;
    }
  }

  /* ---- Desktop Nav Links (Hidden < 1024px) ---- */
  .nav-desktop-menu {
    display: none !important;
  }

  @media (min-width: 1024px) {
    .nav-desktop-menu {
      display: flex !important;
      align-items: center !important;
      gap: 2rem !important;
      font-size: 14px !important;
      font-weight: 400 !important;
      color: #121212 !important;
      letter-spacing: 0.02em !important;
      margin: 0 !important;
      padding: 0 !important;
      list-style: none !important;
    }
  }

  .nav-link-item {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
  }

  .nav-desktop-link {
    position: relative !important;
    padding: 1.5rem 0 !important;
    color: #121212 !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
    transition: color 0.15s ease !important;
    font-size: 14px !important;
  }

  .nav-desktop-link:hover,
  .nav-link-item:hover > .nav-desktop-link {
    color: #5c2d76 !important;
  }

  /* Bottom purple indicator line */
  .nav-desktop-link .nav-indicator-line {
    position: absolute !important;
    bottom: 1rem !important;
    left: 0 !important;
    right: 0 !important;
    height: 2px !important;
    background-color: #5c2d76 !important;
    opacity: 0 !important;
    transform: scaleX(0) !important;
    transition: all 0.2s ease !important;
  }

  .nav-link-item:hover > .nav-desktop-link .nav-indicator-line,
  .nav-desktop-link.is-active .nav-indicator-line {
    opacity: 1 !important;
    transform: scaleX(1) !important;
  }

  .nav-chevron-icon {
    color: #707070 !important;
    transition: transform 0.2s ease !important;
    flex-shrink: 0 !important;
  }

  .nav-link-item:hover .nav-chevron-icon {
    transform: rotate(180deg) !important;
    color: #5c2d76 !important;
  }

  /* Dropdown card */
  .nav-dropdown-panel {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    width: 15rem !important;
    background: #FFFFFF !important;
    border: 1px solid #EAEAEA !important;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    border-radius: 0 0 0.75rem 0.75rem !important;
    padding: 0.5rem 0 !important;
    z-index: 550 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(6px) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .nav-link-item:hover .nav-dropdown-panel {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  .nav-dropdown-header {
    padding: 0.375rem 0.75rem !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    color: #888888 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .nav-dropdown-item {
    display: block !important;
    padding: 0.5rem 1rem !important;
    font-size: 13px !important;
    color: #222222 !important;
    text-decoration: none !important;
    transition: background-color 0.15s ease, color 0.15s ease !important;
  }

  .nav-dropdown-item:hover {
    background-color: #FAF5F2 !important;
    color: #5c2d76 !important;
  }

  /* ---- Right Action Icons (Language Switch, Search, Account, Bag) ---- */
  .nav-right-actions {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 0.25rem !important;
    z-index: 10 !important;
  }

  @media (min-width: 640px) {
    .nav-right-actions {
      gap: 0.5rem !important;
    }
  }

  /* Language Switch Pill */
  .nav-lang-btn {
    display: inline-flex !important;
    align-items: center !important;
    background-color: #FAF5F2 !important;
    color: #121212 !important;
    border: 1px solid #EBE0DA !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    padding: 0.125rem 0.5rem !important;
    border-radius: 9999px !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: all 0.15s ease !important;
  }

  @media (min-width: 640px) {
    .nav-lang-btn {
      padding: 0.25rem 0.625rem !important;
    }
  }

  .nav-lang-btn:hover {
    background-color: #F3EBE7 !important;
    border-color: #5c2d76 !important;
  }

  /* Circle icon button */
  .nav-action-icon-btn {
    color: #121212 !important;
    background: transparent !important;
    border: none !important;
    padding: 0.375rem !important;
    border-radius: 9999px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    text-decoration: none !important;
    position: relative !important;
    transition: color 0.15s ease, background-color 0.15s ease !important;
  }

  @media (min-width: 640px) {
    .nav-action-icon-btn {
      padding: 0.5rem !important;
    }
  }

  .nav-action-icon-btn:hover {
    color: #5c2d76 !important;
    background-color: #FAF5F2 !important;
  }

  .nav-account-wrap {
    display: none !important;
  }

  @media (min-width: 1024px) {
    .nav-account-wrap {
      display: block !important;
    }
  }

  /* Cart Badge */
  .nav-cart-badge {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    background-color: #5c2d76 !important;
    color: #FFFFFF !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    width: 1.125rem !important;
    height: 1.125rem !important;
    border-radius: 9999px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
  }

  /* ---- Search Overlay (matching Next.js Navbar) ---- */
  .nav-search-overlay {
    display: none;
    border-top: 1px solid #ECECEC !important;
    background-color: #FFFFFF !important;
    padding: 1rem !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
  }

  .nav-search-overlay.is-active {
    display: block !important;
  }

  .nav-search-inner {
    max-width: 48rem !important;
    margin: 0 auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem !important;
  }

  .nav-search-form {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
  }

  .nav-search-input-wrap {
    position: relative !important;
    flex: 1 !important;
  }

  .nav-search-icon-inside {
    position: absolute !important;
    left: 0.875rem !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    color: #888888 !important;
    pointer-events: none !important;
  }

  .nav-search-input {
    width: 100% !important;
    padding: 0.625rem 1rem 0.625rem 2.5rem !important;
    background-color: #FAF5F2 !important;
    border: 1px solid #E8DED8 !important;
    border-radius: 0.5rem !important;
    font-size: 14px !important;
    color: #121212 !important;
    outline: none !important;
    transition: all 0.15s ease !important;
  }

  .nav-search-input:focus {
    background-color: #FFFFFF !important;
    border-color: #5c2d76 !important;
  }

  .nav-search-submit-btn {
    background-color: #5c2d76 !important;
    color: #FFFFFF !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    padding: 0.625rem 1rem !important;
    border-radius: 0.5rem !important;
    border: none !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease !important;
  }

  .nav-search-submit-btn:hover {
    background-color: #4a245f !important;
  }

  .nav-search-cancel-btn {
    font-size: 13px !important;
    color: #707070 !important;
    background: transparent !important;
    border: none !important;
    padding: 0.5rem !important;
    cursor: pointer !important;
  }

  .nav-search-cancel-btn:hover {
    color: #121212 !important;
  }

  .nav-search-chips {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 0.5rem !important;
    padding-top: 0.25rem !important;
  }

  .nav-search-chips-label {
    font-size: 12px !important;
    color: #707070 !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
  }

  .nav-search-chip-btn {
    font-size: 12px !important;
    background-color: #FAF5F2 !important;
    color: #444444 !important;
    border: 1px solid #E8DED8 !important;
    padding: 0.25rem 0.625rem !important;
    border-radius: 9999px !important;
    text-decoration: none !important;
    transition: all 0.15s ease !important;
  }

  .nav-search-chip-btn:hover {
    background-color: #F3EBE7 !important;
    color: #121212 !important;
  }
</style>

<header class="site-header eyenova-navbar-root" id="SiteHeader">
  <div class="eyenova-nav-container">
    <!-- Mobile Left: Hamburger Button (< 1024px) -->
    <div class="nav-mobile-toggle-wrap">
      <button
        type="button"
        class="nav-hamburger-btn"
        data-mobile-nav-open
        id="mobileMenuOpenBtn"
        aria-label="Open navigation menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Logo: Centered on mobile with strict bounding box, Left-aligned on desktop -->
    <div class="nav-brand-slot">
      {% render 'brand-logo', size: 'md', variant: 'dark', with_text: true, show_arabic: true %}
    </div>

    <!-- Center Desktop Navigation Menu (hidden on mobile, visible on desktop) -->
    <nav class="nav-desktop-menu" aria-label="Main Navigation">
      <!-- 1. Home Link -->
      <div class="nav-link-item">
        <a href="/" class="nav-desktop-link {% if request.path == '/' %}is-active{% endif %}">
          <span>Home</span>
          <span class="nav-indicator-line"></span>
        </a>
      </div>

      <!-- 2. Medical Lens Dropdown -->
      <div class="nav-link-item">
        <a href="/collections/all?category=medical" class="nav-desktop-link">
          <span>Medical Lens</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-chevron-icon">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
          <span class="nav-indicator-line"></span>
        </a>

        <div class="nav-dropdown-panel">
          <div class="nav-dropdown-header">Medical Categories</div>
          <a href="/collections/all?type=daily" class="nav-dropdown-item">Daily Disposable</a>
          <a href="/collections/all?type=monthly" class="nav-dropdown-item">Monthly Disposable</a>
          <a href="/collections/all?type=astigmatism" class="nav-dropdown-item">Astigmatism (Toric)</a>
          <a href="/collections/all?type=multifocal" class="nav-dropdown-item">Multifocal (Presbyopia)</a>
          <a href="/collections/all?brand=acuvue" class="nav-dropdown-item">Acuvue (Johnson &amp; Johnson)</a>
          <a href="/collections/all?brand=alcon" class="nav-dropdown-item">Alcon Precision</a>
          <a href="/collections/all?brand=bausch" class="nav-dropdown-item">Bausch + Lomb</a>
          <a href="/collections/all?brand=coopervision" class="nav-dropdown-item">CooperVision</a>
        </div>
      </div>

      <!-- 3. Colour Lenses Dropdown -->
      <div class="nav-link-item">
        <a href="/collections/all?category=colored" class="nav-desktop-link">
          <span>Colour Lenses</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-chevron-icon">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
          <span class="nav-indicator-line"></span>
        </a>

        <div class="nav-dropdown-panel">
          <div class="nav-dropdown-header">Trending Brands</div>
          <a href="/collections/all?brand=amara" class="nav-dropdown-item">Amara Luxury Lenses</a>
          <a href="/collections/all?brand=bella" class="nav-dropdown-item">Bella Natural Collection</a>
          <a href="/collections/all?brand=diva" class="nav-dropdown-item">Diva Cosmetic Series</a>
          <a href="/collections/all?brand=lensme" class="nav-dropdown-item">LensMe Korea Collection</a>
          <a href="/collections/all?brand=freshlook" class="nav-dropdown-item">FreshLook Classic</a>
          <a href="/collections/all?brand=acuvue" class="nav-dropdown-item">Acuvue Define Ring</a>
        </div>
      </div>

      <!-- 4. Solutions & Drops -->
      <div class="nav-link-item">
        <a href="/collections/all?category=solutions" class="nav-desktop-link">
          <span>Solutions &amp; Drops</span>
          <span class="nav-indicator-line"></span>
        </a>
      </div>

      <!-- 5. Lashes & Accessories -->
      <div class="nav-link-item">
        <a href="/collections/all?category=lashes" class="nav-desktop-link">
          <span>Lashes &amp; Accessories</span>
          <span class="nav-indicator-line"></span>
        </a>
      </div>
    </nav>

    <!-- Right Action Icons: Language Switch, Search, Account, Bag -->
    <div class="nav-right-actions">
      <!-- Bilingual Language Switch -->
      {% render 'language-switcher' %}

      <!-- Search Trigger -->
      <button
        type="button"
        class="nav-action-icon-btn"
        id="navSearchToggleBtn"
        onclick="toggleNavSearch()"
        aria-label="Search catalog"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Account (Desktop only) -->
      <div class="nav-account-wrap">
        <a href="/account" class="nav-action-icon-btn" aria-label="Account profile">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      </div>

      <!-- Shopping Bag Icon with Badge -->
      <button
        type="button"
        class="nav-action-icon-btn"
        data-cart-toggle
        aria-label="Shopping Cart"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="nav-cart-badge" id="CartCountBadge">{{ cart.item_count }}</span>
        {% endif %}
      </button>
    </div>
  </div>

  <!-- Interactive Search Overlay with Popular Chips -->
  <div class="nav-search-overlay" id="navSearchOverlay">
    <div class="nav-search-inner">
      <form action="/search" method="get" role="search" class="nav-search-form">
        <div class="nav-search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-search-icon-inside">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="text"
            name="q"
            id="navSearchField"
            placeholder="Search lenses, brands, solutions..."
            class="nav-search-input"
            value="{{ search.terms | escape }}"
          >
        </div>
        <button type="submit" class="nav-search-submit-btn">Search</button>
        <button type="button" class="nav-search-cancel-btn" onclick="toggleNavSearch(false)">Cancel</button>
      </form>

      <div class="nav-search-chips">
        <span class="nav-search-chips-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="2"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
          Popular:
        </span>
        <a href="/search?q=Acuvue+Moist" class="nav-search-chip-btn">Acuvue Moist</a>
        <a href="/search?q=Bella+Contour" class="nav-search-chip-btn">Bella Contour</a>
        <a href="/search?q=LensMe+Korea" class="nav-search-chip-btn">LensMe Korea</a>
        <a href="/search?q=Daily+Lenses" class="nav-search-chip-btn">Daily Lenses</a>
        <a href="/search?q=Opti-Free" class="nav-search-chip-btn">Opti-Free Solution</a>
        <a href="/search?q=Amara+One+Day" class="nav-search-chip-btn">Amara One Day</a>
      </div>
    </div>
  </div>
</header>

<script>
  function toggleNavSearch(forceState) {
    var overlay = document.getElementById('navSearchOverlay');
    var input = document.getElementById('navSearchField');
    if (!overlay) return;
    if (typeof forceState === 'boolean') {
      if (forceState) {
        overlay.classList.add('is-active');
        if (input) input.focus();
      } else {
        overlay.classList.remove('is-active');
      }
    } else {
      overlay.classList.toggle('is-active');
      if (overlay.classList.contains('is-active') && input) {
        input.focus();
      }
    }
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
