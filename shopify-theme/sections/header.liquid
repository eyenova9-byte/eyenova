<header class="site-header analog-header" id="SiteHeader">
  <!-- 1. Analog Announcement Bar -->
  <div class="analog-announcement-bar">
    <div class="header-inner announcement-inner">
      <div class="announcement-left">
        <span class="announcement-badge">MOPH Approved</span>
        <span class="announcement-text">100% Authentic Certified Optical Products</span>
      </div>
      <div class="announcement-center">
        <a href="/collections/all" class="announcement-link">
          <span class="announcement-pulse-dot"></span>
          <span>Same-Day Express Qatar Delivery &bull; Free on Orders Over QAR 250</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
      <div class="announcement-right">
        <a href="https://wa.me/97455989711" target="_blank" rel="noopener noreferrer" class="announcement-wa">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.284l-.711 2.6 2.664-.698c.96.523 1.956.814 3.037.814 3.182 0 5.768-2.586 5.769-5.766.001-3.18-2.585-5.766-5.768-5.766zm3.374 8.169c-.147.414-.755.772-1.042.822-.287.05-.658.077-2.115-.494-1.782-.698-2.915-2.525-3.003-2.643-.089-.118-.72-1.002-.72-1.91 0-.909.475-1.354.644-1.538.169-.184.368-.231.491-.231.123 0 .245.002.352.007.112.006.262-.043.41.314.153.37.522 1.272.568 1.365.046.092.077.2.015.323-.061.123-.092.2-.184.308-.092.108-.194.24-.277.323-.092.092-.188.192-.081.376.107.184.476.786 1.02 1.27.701.625 1.293.818 1.477.91.184.092.292.077.4-.046.107-.123.46-.538.583-.722.123-.184.246-.153.414-.092.169.061 1.074.507 1.258.6.184.092.307.138.352.215.046.077.046.445-.101.859z"/></svg>
          <span>Concierge: +974 5598 9711</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Analog Main Navigation Bar -->
  <div class="analog-main-nav">
    <div class="header-inner main-nav-inner">
      <!-- Mobile Hamburger Button -->
      <div class="mobile-nav-toggle-wrap">
        <button type="button" class="mobile-hamburger-btn" onclick="openMobileDrawer()" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Analog Brand Logo (High-fashion Atelier typography) -->
      <div class="analog-logo-wrap">
        <a href="/" class="analog-brand-link" aria-label="EyeNova Home">
          <div class="analog-logo-symbol">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3" fill="#5c2d76" stroke="none"/>
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" stroke="#5c2d76"/>
            </svg>
          </div>
          <div class="analog-logo-text">
            <span class="analog-brand-name">EyeNova</span>
            <span class="analog-brand-sub">ATELIER &bull; QATAR</span>
          </div>
        </a>
      </div>

      <!-- Analog Center Desktop Navigation with Mega Menus & Promos -->
      <nav class="analog-desktop-nav" aria-label="Main Navigation">
        <ul class="analog-nav-list">
          <!-- Home -->
          <li class="analog-nav-item">
            <a href="/" class="analog-nav-link {% if request.path == '/' %}analog-nav-active{% endif %}">
              <span>Home</span>
            </a>
          </li>

          <!-- Medical Lenses (Analog Mega Menu) -->
          <li class="analog-nav-item analog-megamenu-parent">
            <a href="/collections/all?category=medical" class="analog-nav-link">
              <span>Medical Lenses</span>
              <svg class="analog-nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <!-- Mega Menu Panel -->
            <div class="analog-megamenu-panel">
              <div class="megamenu-inner">
                <!-- Column 1: By Duration -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">By Wear Duration</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?type=daily" class="megamenu-link">Daily Disposable Lenses</a></li>
                    <li><a href="/collections/all?type=monthly" class="megamenu-link">Monthly Disposable Lenses</a></li>
                    <li><a href="/collections/all?type=3_months" class="megamenu-link">3-Month Extended Wear</a></li>
                    <li><a href="/collections/all?type=6_months" class="megamenu-link">6-Month Precision Wear</a></li>
                    <li><a href="/collections/all" class="megamenu-link view-all-link">View All Modalities &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 2: By Prescription Condition -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">Vision Correction</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?type=standard" class="megamenu-link">Myopia / Hyperopia (Sphere)</a></li>
                    <li><a href="/collections/all?type=astigmatism" class="megamenu-link">Astigmatism Lenses (Toric)</a></li>
                    <li><a href="/collections/all?type=multifocal" class="megamenu-link">Multifocal / Presbyopia</a></li>
                    <li><a href="/collections/all?category=medical" class="megamenu-link">Silicon Hydrogel Breathable</a></li>
                    <li><a href="/collections/all?type=daily" class="megamenu-link view-all-link">Shop Daily Moist &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 3: Certified Brands -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">Authorized Brands</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?brand=acuvue" class="megamenu-link">Acuvue (Johnson & Johnson)</a></li>
                    <li><a href="/collections/all?brand=alcon" class="megamenu-link">Alcon Precision & Dailies</a></li>
                    <li><a href="/collections/all?brand=coopervision" class="megamenu-link">CooperVision Biofinity</a></li>
                    <li><a href="/collections/all?brand=bausch" class="megamenu-link">Bausch + Lomb Biotrue</a></li>
                    <li><a href="/collections/all" class="megamenu-link view-all-link">Browse All 8 Brands &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 4: Analog In-Menu Featured Promo Card -->
                <div class="megamenu-col megamenu-promo-col">
                  <div class="megamenu-promo-card">
                    <div class="promo-image-wrap">
                      <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=450&auto=format&fit=crop" alt="1 Day Acuvue Moist" loading="lazy">
                      <span class="promo-badge">Top Seller</span>
                    </div>
                    <div class="promo-info">
                      <span class="promo-tag">Johnson & Johnson</span>
                      <h5 class="promo-title">1 Day Acuvue Moist 30PK</h5>
                      <span class="promo-price">QAR 159.00</span>
                      <a href="/collections/all?brand=acuvue" class="promo-btn">Explore Lenses</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- Colour Lenses (Analog Mega Menu) -->
          <li class="analog-nav-item analog-megamenu-parent">
            <a href="/collections/all?category=colored" class="analog-nav-link">
              <span>Colour Lenses</span>
              <svg class="analog-nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <!-- Mega Menu Panel -->
            <div class="analog-megamenu-panel">
              <div class="megamenu-inner">
                <!-- Column 1: Trending Collections -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">Celebrity Collections</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?brand=bella" class="megamenu-link">Bella Diamond & Elite</a></li>
                    <li><a href="/collections/all?brand=amara" class="megamenu-link">Amara Celebrity Colours</a></li>
                    <li><a href="/collections/all?brand=lensme" class="megamenu-link">LensMe Korea & Natural</a></li>
                    <li><a href="/collections/all?brand=diva" class="megamenu-link">Diva Natural Shades</a></li>
                    <li><a href="/collections/all?category=colored" class="megamenu-link view-all-link">View All Colours &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 2: Shades by Tone -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">Shop By Shade</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?category=colored" class="megamenu-link">Natural Hazel & Sandy Brown</a></li>
                    <li><a href="/collections/all?category=colored" class="megamenu-link">Diamond Gray & Shadow</a></li>
                    <li><a href="/collections/all?category=colored" class="megamenu-link">Olive Green & Mint</a></li>
                    <li><a href="/collections/all?category=colored" class="megamenu-link">Deep Ocean Blue & Aqua</a></li>
                    <li><a href="/collections/all?category=colored" class="megamenu-link view-all-link">Browse Shade Guide &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 3: Duration & Care -->
                <div class="megamenu-col">
                  <h4 class="megamenu-heading">Wear & Prescription</h4>
                  <ul class="megamenu-links">
                    <li><a href="/collections/all?brand=acuvue" class="megamenu-link">Acuvue Define Daily Accent</a></li>
                    <li><a href="/collections/all?type=monthly" class="megamenu-link">Monthly Beauty Lenses</a></li>
                    <li><a href="/collections/all?type=colored" class="megamenu-link">Plano (0.00 Cosmetic Only)</a></li>
                    <li><a href="/collections/all?type=colored" class="megamenu-link">Power Correction (-0.50 to -8.00)</a></li>
                    <li><a href="/collections/all?category=solutions" class="megamenu-link view-all-link">Lens Solutions & Drops &rarr;</a></li>
                  </ul>
                </div>

                <!-- Column 4: Analog In-Menu Featured Promo Card -->
                <div class="megamenu-col megamenu-promo-col">
                  <div class="megamenu-promo-card">
                    <div class="promo-image-wrap">
                      <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=450&auto=format&fit=crop" alt="Bella Diamond Gray Shadow" loading="lazy">
                      <span class="promo-badge">Celebrity Pick</span>
                    </div>
                    <div class="promo-info">
                      <span class="promo-tag">Bella Elite</span>
                      <h5 class="promo-title">Bella Diamond Gray Shadow</h5>
                      <span class="promo-price">QAR 130.00</span>
                      <a href="/collections/all?brand=bella" class="promo-btn">View Colorway</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- Solutions & Drops -->
          <li class="analog-nav-item">
            <a href="/collections/all?category=solutions" class="analog-nav-link">
              <span>Solutions & Drops</span>
            </a>
          </li>

          <!-- Eyewear & Shades -->
          <li class="analog-nav-item">
            <a href="/collections/all?category=eyewear" class="analog-nav-link">
              <span>Eyewear & Shades</span>
            </a>
          </li>

          <!-- About & Locations -->
          <li class="analog-nav-item">
            <a href="/pages/about" class="analog-nav-link">
              <span>About & Locations</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Analog Right Utilities (Search, Language, Bag) -->
      <div class="analog-utilities">
        <!-- Search Trigger -->
        <a href="/search" class="analog-util-btn" aria-label="Search catalog">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </a>

        <!-- Language Switcher -->
        {% render 'language-switcher' %}

        <!-- Shopping Bag Trigger -->
        <a href="/cart" class="analog-bag-btn" data-cart-toggle aria-label="Shopping Bag">
          <div class="analog-bag-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="analog-bag-badge" id="CartCountBadge">{{ cart.item_count }}</span>
          </div>
          <span class="analog-bag-label">Bag</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 3. Analog Sub-Header Category Navigation Strip -->
  <div class="analog-sub-header">
    <div class="header-inner sub-header-inner">
      <nav class="sub-nav-track" aria-label="Category Quick Links">
        <a href="/collections/all" class="sub-nav-pill {% if request.path == '/collections/all' %}active{% endif %}">All Collections</a>
        <a href="/collections/all?type=daily" class="sub-nav-pill">Daily Lenses</a>
        <a href="/collections/all?type=monthly" class="sub-nav-pill">Monthly Lenses</a>
        <a href="/collections/all?category=colored" class="sub-nav-pill">Colour Lenses</a>
        <a href="/collections/all?type=astigmatism" class="sub-nav-pill">Astigmatism (Toric)</a>
        <a href="/collections/all?type=multifocal" class="sub-nav-pill">Multifocal</a>
        <a href="/collections/all?category=solutions" class="sub-nav-pill">Solutions & Drops</a>
        <a href="/collections/all?category=eyewear" class="sub-nav-pill">Eyeglasses</a>
        <a href="/collections/all?category=sunglasses" class="sub-nav-pill">Sunglasses</a>
        <a href="/pages/about" class="sub-nav-pill">Locations & Boutique</a>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
