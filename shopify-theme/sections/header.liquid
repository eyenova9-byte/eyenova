<header class="site-header" id="SiteHeader">
  <!-- Main Header Row -->
  <div class="header-main-row">
    <div class="header-inner">
      <!-- Mobile Hamburger Toggle (Small Screens) -->
      <div class="mobile-menu-toggle-wrap">
        <button type="button" class="mobile-menu-btn" id="mobileMenuOpenBtn" onclick="openMobileDrawer()" aria-label="Open Navigation Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Brand Logo -->
      <a href="/" class="brand-logo-link">
        <div class="brand-logo-symbol">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3" fill="#5c2d76" stroke="none"/>
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" stroke="#5c2d76"/>
          </svg>
        </div>
        <div class="brand-text-wrap">
          <span class="brand-title">EyeNova</span>
          <span class="brand-tagline">ATELIER &bull; QATAR</span>
        </div>
      </a>

      <!-- Desktop Center Navigation Menu (Strict Single Line - No Wrapping) -->
      <nav class="desktop-navigation">
        <ul class="nav-links">
          <li>
            <a href="/" class="nav-link {% if request.path == '/' %}nav-link-active{% endif %}">
              <span>Home</span>
            </a>
          </li>
          <li class="nav-dropdown-wrapper">
            <a href="/collections/all?category=medical" class="nav-link">
              <span>Medical Lenses</span>
              <svg class="dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="nav-dropdown-menu">
              <a href="/collections/all?type=daily" class="dropdown-item">Daily Disposable Lenses</a>
              <a href="/collections/all?type=monthly" class="dropdown-item">Monthly Disposable Lenses</a>
              <a href="/collections/all?type=astigmatism" class="dropdown-item">Astigmatism (Toric) Lenses</a>
              <a href="/collections/all?type=multifocal" class="dropdown-item">Multifocal (Presbyopia)</a>
              <div class="dropdown-divider"></div>
              <a href="/collections/all?brand=acuvue" class="dropdown-item">Acuvue (Johnson & Johnson)</a>
              <a href="/collections/all?brand=alcon" class="dropdown-item">Alcon Precision Lenses</a>
              <a href="/collections/all?brand=bausch" class="dropdown-item">Bausch + Lomb</a>
            </div>
          </li>
          <li class="nav-dropdown-wrapper">
            <a href="/collections/all?category=colored" class="nav-link">
              <span>Colour Lenses</span>
              <svg class="dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="nav-dropdown-menu">
              <a href="/collections/all?brand=amara" class="dropdown-item">Amara Celebrity Colours</a>
              <a href="/collections/all?brand=bella" class="dropdown-item">Bella Luxury Shades</a>
              <a href="/collections/all?brand=diva" class="dropdown-item">Diva Natural Collection</a>
              <a href="/collections/all?brand=lensme" class="dropdown-item">LensMe Korea & Arabic Style</a>
              <a href="/collections/all?brand=freshlook" class="dropdown-item">FreshLook Colorblends</a>
              <a href="/collections/all?brand=acuvue-define" class="dropdown-item">Acuvue Define Daily Accent</a>
            </div>
          </li>
          <li>
            <a href="/collections/all?category=solutions" class="nav-link">
              <span>Solutions & Drops</span>
            </a>
          </li>
          <li>
            <a href="/collections/all?category=eyewear" class="nav-link">
              <span>Eyewear & Shades</span>
            </a>
          </li>
          <li>
            <a href="/pages/about" class="nav-link">
              <span>About & Locations</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Search -->
        <a href="/search" class="header-icon-btn" aria-label="Search Catalog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </a>

        <!-- Language Selector -->
        {% render 'language-switcher' %}

        <!-- Bag / Cart Drawer Button -->
        <a href="/cart" class="header-cart-btn" data-cart-toggle aria-label="Shopping Bag">
          <div class="cart-icon-wrapper">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="cart-count-pill" id="CartCountBadge">{{ cart.item_count }}</span>
          </div>
          <span class="cart-label-text">Bag</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Sub-Header Category Navigation Bar (Desktop & Smooth Horizontal Scroll on Mobile) -->
  <div class="header-sub-nav-bar">
    <div class="sub-nav-container">
      <nav class="sub-nav-track" aria-label="Category Quick Links">
        <a href="/collections/all" class="sub-nav-pill {% if request.path == '/collections/all' %}active{% endif %}">All Collections</a>
        <a href="/collections/all?type=daily" class="sub-nav-pill">Daily Lenses</a>
        <a href="/collections/all?type=monthly" class="sub-nav-pill">Monthly Lenses</a>
        <a href="/collections/all?category=colored" class="sub-nav-pill">Colour Lenses</a>
        <a href="/collections/all?type=astigmatism" class="sub-nav-pill">Astigmatism (Toric)</a>
        <a href="/collections/all?type=multifocal" class="sub-nav-pill">Multifocal</a>
        <a href="/collections/all?category=solutions" class="sub-nav-pill">Solutions & Drops</a>
        <a href="/collections/all?category=eyewear" class="sub-nav-pill">Eyeglasses</a>
        <a href="/collections/all?category=sunglasses" class="sub-nav-pill">Sunglasses</a>
        <a href="/pages/about" class="sub-nav-pill">Locations & Boutique</a>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
