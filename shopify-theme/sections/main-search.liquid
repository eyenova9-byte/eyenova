<section style="padding: 4rem 2rem; max-width: 1200px; margin: 0 auto;">
  <h1 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--color-primary); text-align: center; margin-bottom: 2rem;">
    Search Eyewear
  </h1>
  <form action="/search" method="get" role="search" style="max-width: 600px; margin: 0 auto 3rem; display: flex; gap: 0.5rem;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" style="flex-grow: 1; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 6px;">
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  {% if search.performed %}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}
{ "name": "Search Results", "settings": [] }
{% endschema %}
