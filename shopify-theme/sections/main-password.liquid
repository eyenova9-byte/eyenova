<section style="padding: 6rem 2rem; text-align: center; max-width: 600px; margin: 0 auto;">
  <div style="margin-bottom: 2rem;">
    {% render 'icon-eye-logo' %}
  </div>
  <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase;">Qatar Atelier</span>
  <h1 style="font-family: var(--font-serif); font-size: 2.8rem; color: var(--color-primary); margin: 1rem 0;">Opening Soon</h1>
  <p style="color: var(--color-muted); margin-bottom: 2.5rem;">We are curating our luxury eyewear collection for Doha. Enter store password to preview.</p>

  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <div style="display: flex; gap: 0.5rem; justify-content: center;">
      <input type="password" name="password" placeholder="Store password" style="padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 6px; width: 240px;">
      <button type="submit" class="btn btn-primary">Enter</button>
    </div>
  {% endform %}
</section>
{% schema %}
{ "name": "Password Page", "settings": [] }
{% endschema %}
