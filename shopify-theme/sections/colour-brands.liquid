<section class="section-container" style="padding-top: 1.5rem; padding-bottom: 2.5rem;">
  <div class="section-header-flex">
    <h2 class="section-heading-clean">Colour Lenses Brands</h2>
    <a href="/collections/all?category=colored" class="section-link-accent">Shop All Colours &rarr;</a>
  </div>

  <div class="horizontal-scroll-wrapper">
    <div id="brandScroll" class="horizontal-scroll-track">
      <!-- Amara -->
      <a href="/collections/all?brand=amara" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop" alt="Amara" loading="lazy">
        </div>
        <span class="circle-cat-label">Amara</span>
      </a>

      <!-- Bella -->
      <a href="/collections/all?brand=bella" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=400&auto=format&fit=crop" alt="Bella" loading="lazy">
        </div>
        <span class="circle-cat-label">Bella</span>
      </a>

      <!-- Diva -->
      <a href="/collections/all?brand=diva" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=400&auto=format&fit=crop" alt="Diva" loading="lazy">
        </div>
        <span class="circle-cat-label">Diva</span>
      </a>

      <!-- LensMe -->
      <a href="/collections/all?brand=lensme" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=400&auto=format&fit=crop" alt="LensMe" loading="lazy">
        </div>
        <span class="circle-cat-label">LensMe</span>
      </a>

      <!-- FreshLook -->
      <a href="/collections/all?brand=freshlook" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&auto=format&fit=crop" alt="FreshLook" loading="lazy">
        </div>
        <span class="circle-cat-label">FreshLook</span>
      </a>

      <!-- Acuvue Define -->
      <a href="/collections/all?brand=acuvue-define" class="circle-cat-card">
        <div class="circle-brand-avatar">
          <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&auto=format&fit=crop" alt="Acuvue Define" loading="lazy">
        </div>
        <span class="circle-cat-label">Acuvue Define</span>
      </a>
    </div>

    <!-- Scroll controls -->
    <div class="scroll-buttons-center">
      <button type="button" class="scroll-arrow-btn" onclick="document.getElementById('brandScroll').scrollBy({left: -260, behavior: 'smooth'})" aria-label="Scroll left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="scroll-arrow-btn" onclick="document.getElementById('brandScroll').scrollBy({left: 260, behavior: 'smooth'})" aria-label="Scroll right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colour Lenses Brands",
  "settings": [],
  "presets": [
    {
      "name": "Colour Lenses Brands"
    }
  ]
}
{% endschema %}
