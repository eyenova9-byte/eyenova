<section class="store-section" data-reveal>
  <div class="store-container">
    <div class="section-title-row">
      <h2 class="section-title-text">Colour Lenses Brands</h2>
      <a href="/collections/all?category=colored" class="section-link-more">Shop All Colours &rarr;</a>
    </div>

    <!-- Scrollable Single Row Container -->
    <div id="brandScroll" class="nextjs-circle-scroll-track">
      <!-- 1. Amara -->
      <a href="/collections/all?brand=amara" class="nextjs-circle-item" data-reveal data-reveal-delay="1">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop" alt="Amara" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Amara</span>
      </a>

      <!-- 2. Bella -->
      <a href="/collections/all?brand=bella" class="nextjs-circle-item" data-reveal data-reveal-delay="2">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=400&auto=format&fit=crop" alt="Bella" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Bella</span>
      </a>

      <!-- 3. Diva -->
      <a href="/collections/all?brand=diva" class="nextjs-circle-item" data-reveal data-reveal-delay="3">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=400&auto=format&fit=crop" alt="Diva" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Diva</span>
      </a>

      <!-- 4. LensMe -->
      <a href="/collections/all?brand=lensme" class="nextjs-circle-item" data-reveal data-reveal-delay="4">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=400&auto=format&fit=crop" alt="LensMe" loading="lazy">
        </div>
        <span class="nextjs-circle-label">LensMe</span>
      </a>

      <!-- 5. FreshLook -->
      <a href="/collections/all?brand=freshlook" class="nextjs-circle-item" data-reveal data-reveal-delay="5">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&auto=format&fit=crop" alt="FreshLook" loading="lazy">
        </div>
        <span class="nextjs-circle-label">FreshLook</span>
      </a>

      <!-- 6. Acuvue Define -->
      <a href="/collections/all?brand=acuvue-define" class="nextjs-circle-item" data-reveal data-reveal-delay="5">
        <div class="nextjs-brand-frame">
          <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&auto=format&fit=crop" alt="Acuvue Define" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Acuvue Define</span>
      </a>
    </div>

    <!-- Bottom Left & Right Scroll Controls -->
    <div class="nextjs-scroll-controls">
      <button type="button" class="nextjs-nav-arrow" onclick="document.getElementById('brandScroll').scrollBy({left: -260, behavior: 'smooth'})" aria-label="Scroll left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="nextjs-nav-arrow" onclick="document.getElementById('brandScroll').scrollBy({left: 260, behavior: 'smooth'})" aria-label="Scroll right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colour Lenses Brands",
  "settings": [],
  "presets": [
    {
      "name": "Colour Lenses Brands"
    }
  ]
}
{% endschema %}
