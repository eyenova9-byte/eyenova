<section style="padding: 4rem 2rem; max-width: 1200px; margin: 0 auto;">
  <h1 style="font-family: var(--font-serif); font-size: 2.5rem; color: var(--color-primary); text-align: center; margin-bottom: 3rem;">
    Eyewear Collections
  </h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
    {% for collection in collections %}
      <div style="background: #ffffff; border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; text-align: center; box-shadow: var(--shadow-subtle);">
        <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--color-primary);">{{ collection.title }}</h3>
        <p style="color: var(--color-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">{{ collection.products_count }} models</p>
        <a href="{{ collection.url }}" class="btn btn-outline">Explore Collection</a>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{ "name": "All Collections", "settings": [] }
{% endschema %}
