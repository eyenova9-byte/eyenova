<!-- 1. Top Collection Banner -->
<div class="shop-banner-clean">
  <div class="store-container">
    <h1 class="shop-page-title">
      {{ collection.title | default: "All Collections" }}
    </h1>
    <p class="shop-page-subtitle">
      Explore certified medical contact lenses, trend-setting colored lenses, and optical essentials with express same-day Qatar delivery.
    </p>
  </div>
</div>

<!-- 2. Full-Width Main Collection Container (NO SIDEBAR ON LARGE SCREENS) -->
<div class="store-container shop-body-container">

  <!-- Top Filter & Category Pills Bar (Desktop & Mobile) -->
  <div class="showcase-top-controls-bar">
    <!-- Category Filter Pills -->
    <div class="showcase-category-pills">
      <button type="button" class="top-cat-pill top-cat-pill-active" data-cat-filter="all">All Products</button>
      <button type="button" class="top-cat-pill" data-cat-filter="daily">Daily Lenses</button>
      <button type="button" class="top-cat-pill" data-cat-filter="monthly">Monthly Lenses</button>
      <button type="button" class="top-cat-pill" data-cat-filter="colored">Colour Lenses</button>
      <button type="button" class="top-cat-pill" data-cat-filter="astigmatism">Astigmatism (Toric)</button>
      <button type="button" class="top-cat-pill" data-cat-filter="solutions">Solutions & Drops</button>
      <button type="button" class="top-cat-pill" data-cat-filter="eyewear">Eyewear</button>
    </div>

    <!-- Quick Brand Pills & Sort -->
    <div class="showcase-brand-sort-row">
      <div class="brand-filter-pills-wrap">
        <span class="filter-lead-label">Brand:</span>
        <button type="button" class="brand-pill" data-brand-filter="acuvue">Acuvue</button>
        <button type="button" class="brand-pill" data-brand-filter="alcon">Alcon</button>
        <button type="button" class="brand-pill" data-brand-filter="bella">Bella</button>
        <button type="button" class="brand-pill" data-brand-filter="amara">Amara</button>
        <button type="button" class="brand-pill" data-brand-filter="lensme">LensMe</button>
        <button type="button" class="brand-pill" data-brand-filter="diva">Diva</button>
        <button type="button" class="brand-pill" data-brand-filter="coopervision">CooperVision</button>
      </div>

      <div class="sort-and-count-wrap">
        <div class="sort-dropdown-custom">
          <label for="ShowcaseSortBy" class="sort-label">Sort by:</label>
          <select id="ShowcaseSortBy" class="sort-native-select">
            <option value="best-selling">Best selling</option>
            <option value="featured">Featured</option>
            <option value="title-ascending">Alphabetically, A-Z</option>
            <option value="title-descending">Alphabetically, Z-A</option>
            <option value="price-ascending">Price, low to high</option>
            <option value="price-descending">Price, high to low</option>
          </select>
          <svg class="sort-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <span class="showcase-count-text" id="showcaseProductCount">24 products</span>
      </div>
    </div>
  </div>

  <!-- Full-Width 4-Column Product Grid (No Cramped Sidebar) -->
  <div class="full-width-showcase-grid" id="productGridContainer">
    {% if collection.products.size > 0 %}
      {% for product in collection.products %}
        <div class="showcase-card-item" data-id="{{ product.id }}" data-brand="{{ product.vendor | downcase }}" data-title="{{ product.title }}" data-price="{{ product.price }}" data-usage="{% if product.tags contains 'daily' %}daily{% elsif product.tags contains 'monthly' %}monthly{% endif %}" data-cat="{% if product.tags contains 'colored' %}colored{% elsif product.tags contains 'solutions' %}solutions{% elsif product.tags contains 'eyewear' %}eyewear{% else %}medical{% endif %}">
          <a href="{{ product.url }}" class="nextjs-product-link">
            <div class="product-image-box">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
              {% else %}
                <div class="image-placeholder-icon">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
              {% endif %}
            </div>
            <h3 class="product-card-title">{{ product.title }}</h3>
            <span class="product-card-price">{{ product.price | money }}</span>
          </a>
        </div>
      {% endfor %}
