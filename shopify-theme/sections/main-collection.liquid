<!-- 1. Top Collection Banner (Exact Next.js Banner) -->
<div class="shop-banner-clean">
  <div class="store-container">
    <h1 class="shop-page-title">
      {{ collection.title | default: "All Products" }}
    </h1>
  </div>
</div>

<!-- 2. Main Collection Grid Container -->
<div class="store-container shop-body-container">

  <!-- Mobile Filter & Sort Bar (Hidden on Desktop) -->
  <div class="shop-mobile-filter-bar">
    <button type="button" class="mobile-filter-trigger-btn" id="openMobileFilterBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
      </svg>
      <span>Filter and sort</span>
      <span class="filter-count-badge" id="mobileFilterCountBadge" style="display: none;">0</span>
    </button>
    <span class="shop-product-count-mobile" id="mobileProductCountText">24 products</span>
  </div>

  <div class="shop-layout-flex">

    <!-- ======================================================================= -->
    <!-- Left Vertical Accordion Filters (Exact Next.js Accordion Parity)        -->
    <!-- ======================================================================= -->
    <aside class="shop-sidebar-filters">
      <!-- Filter Header & Remove All -->
      <div class="filter-sidebar-header">
        <span class="filter-title-label">Filter:</span>
        <button type="button" class="filter-remove-all-btn" id="removeAllFiltersBtn" style="display: none;">
          Remove all
        </button>
      </div>

      <!-- Filter 1: Usage (Daily, Monthly) -->
      <details class="filter-accordion-group" open>
        <summary class="filter-accordion-summary">
          <span>Usage <span id="usageFilterCount"></span></span>
          <svg class="summary-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="filter-checkbox-label">
            <input type="checkbox" name="usageFilter" value="daily" class="filter-checkbox-input">
            <span>Daily</span>
          </label>
          <label class="filter-checkbox-label">
            <input type="checkbox" name="usageFilter" value="monthly" class="filter-checkbox-input">
            <span>Monthly</span>
          </label>
        </div>
      </details>

      <!-- Filter 2: Type -->
      <details class="filter-accordion-group">
        <summary class="filter-accordion-summary">
          <span>Type <span id="typeFilterCount"></span></span>
          <svg class="summary-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="filter-checkbox-label">
            <input type="checkbox" name="typeFilter" value="standard" class="filter-checkbox-input">
            <span>Standard Prescription Lens</span>
          </label>
          <label class="filter-checkbox-label">
            <input type="checkbox" name="typeFilter" value="astigmatism" class="filter-checkbox-input">
            <span>Astigmatism Lenses (Toric)</span>
          </label>
          <label class="filter-checkbox-label">
            <input type="checkbox" name="typeFilter" value="colored" class="filter-checkbox-input">
            <span>Colored Lenses</span>
          </label>
          <label class="filter-checkbox-label">
            <input type="checkbox" name="typeFilter" value="solution" class="filter-checkbox-input">
            <span>Solutions & Eye Care</span>
          </label>
        </div>
      </details>

      <!-- Filter 3: Power (Negative Diopters -0.50 to -8.00) -->
      <details class="filter-accordion-group">
        <summary class="filter-accordion-summary">
          <span>Power <span id="powerFilterCount"></span></span>
          <svg class="summary-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content filter-scroll-box">
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="0.00" class="filter-checkbox-input"><span>0.00 (Plano)</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-0.50" class="filter-checkbox-input"><span>-0.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-0.75" class="filter-checkbox-input"><span>-0.75</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-1.00" class="filter-checkbox-input"><span>-1.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-1.25" class="filter-checkbox-input"><span>-1.25</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-1.50" class="filter-checkbox-input"><span>-1.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-1.75" class="filter-checkbox-input"><span>-1.75</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-2.00" class="filter-checkbox-input"><span>-2.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-2.50" class="filter-checkbox-input"><span>-2.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-3.00" class="filter-checkbox-input"><span>-3.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-3.50" class="filter-checkbox-input"><span>-3.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-4.00" class="filter-checkbox-input"><span>-4.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-4.50" class="filter-checkbox-input"><span>-4.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-5.00" class="filter-checkbox-input"><span>-5.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-5.50" class="filter-checkbox-input"><span>-5.50</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-6.00" class="filter-checkbox-input"><span>-6.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-7.00" class="filter-checkbox-input"><span>-7.00</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="powerFilter" value="-8.00" class="filter-checkbox-input"><span>-8.00</span></label>
        </div>
      </details>

      <!-- Filter 4: Brand -->
      <details class="filter-accordion-group" open>
        <summary class="filter-accordion-summary">
          <span>Brand <span id="brandFilterCount"></span></span>
          <svg class="summary-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="acuvue" class="filter-checkbox-input"><span>Acuvue</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="alcon" class="filter-checkbox-input"><span>Alcon</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="bella" class="filter-checkbox-input"><span>Bella</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="amara" class="filter-checkbox-input"><span>Amara</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="lensme" class="filter-checkbox-input"><span>LensMe</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="diva" class="filter-checkbox-input"><span>Diva</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="coopervision" class="filter-checkbox-input"><span>CooperVision</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="bausch + lomb" class="filter-checkbox-input"><span>Bausch + Lomb</span></label>
          <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="eyenova" class="filter-checkbox-input"><span>EyeNova</span></label>
        </div>
      </details>
    </aside>

    <!-- ======================================================================= -->
    <!-- Right Product Showcase Grid & Sort By Header                           -->
    <!-- ======================================================================= -->
    <main class="shop-main-content">
      <!-- Desktop Sort Bar -->
      <div class="desktop-sort-bar">
        <div class="sort-select-wrap">
          <label for="ShopSortBy" class="sort-label">Sort by:</label>
          <div class="sort-dropdown-custom">
            <select id="ShopSortBy" class="sort-native-select">
              <option value="best-selling">Best selling</option>
              <option value="featured">Featured</option>
              <option value="title-ascending">Alphabetically, A-Z</option>
              <option value="title-descending">Alphabetically, Z-A</option>
              <option value="price-ascending">Price, low to high</option>
              <option value="price-descending">Price, high to low</option>
            </select>
            <svg class="sort-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <span class="desktop-product-count" id="desktopProductCountText">24 products</span>
      </div>

      <!-- 4-Column Product Grid (Exact Next.js Grid: grid-cols-2 sm:grid-cols-2 lg:grid-cols-4) -->
      <div class="nextjs-showcase-grid" id="productGridContainer">
        <!-- Render Products (Shopify Collection or Curated Catalog) -->
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <div class="showcase-card-item" data-id="{{ product.id }}" data-brand="{{ product.vendor | downcase }}" data-title="{{ product.title }}" data-price="{{ product.price }}" data-usage="{% if product.tags contains 'daily' %}daily{% elsif product.tags contains 'monthly' %}monthly{% endif %}" data-type="{% if product.tags contains 'astigmatism' %}astigmatism{% elsif product.tags contains 'colored' %}colored{% else %}standard{% endif %}">
              <a href="{{ product.url }}" class="nextjs-product-link">
                <div class="product-image-box">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="image-placeholder-icon">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                  {% endif %}
                </div>
                <h3 class="product-card-title">{{ product.title }}</h3>
                <span class="product-card-price">{{ product.price | money }}</span>
              </a>
            </div>
          {% endfor %}
        {% else %}
          <!-- Full Curated 24 Product Catalog Matching Next.js lib/mockData.ts -->
          
