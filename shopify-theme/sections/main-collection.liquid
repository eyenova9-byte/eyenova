<!-- 3. CLIENT-SIDE IN-PAGE FILTER ENGINE -->
<script>
(function() {
  var activeCategory = 'all';
  var selectedSort = 'best-selling';

  function getCheckedValues(name) {
    var inputs = document.querySelectorAll('input[name="' + name + '"]:checked');
    var vals = [];
    inputs.forEach(function(i) { vals.push(i.value.toLowerCase()); });
    return vals;
  }

  function updateBadge(badgeId, count) {
    var b = document.getElementById(badgeId);
    if (!b) return;
    if (count > 0) {
      b.textContent = count;
      b.style.display = 'inline-flex';
    } else {
      b.style.display = 'none';
    }
  }

  window.toggleDropdown = function(id) {
    var target = document.getElementById(id);
    var allDropdowns = document.querySelectorAll('.inpage-dropdown');
    allDropdowns.forEach(function(d) {
      if (d !== target) d.classList.remove('inpage-dropdown-open');
    });
    if (target) {
      target.classList.toggle('inpage-dropdown-open');
    }
  };

  // Close dropdowns on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.inpage-dropdown')) {
      document.querySelectorAll('.inpage-dropdown').forEach(function(d) {
        d.classList.remove('inpage-dropdown-open');
      });
    }
  });

  window.clearGroup = function(name) {
    var inputs = document.querySelectorAll('input[name="' + name + '"]');
    inputs.forEach(function(i) { i.checked = false; });
    handleFilterChange();
  };

  window.clearAllFilters = function() {
    document.querySelectorAll('.inpage-filter-toolbar input[type="checkbox"]').forEach(function(i) {
      i.checked = false;
    });
    activeCategory = 'all';
    document.querySelectorAll('.inpage-cat-pill').forEach(function(p) {
      p.classList.remove('inpage-cat-pill-active');
    });
    var allPill = document.querySelector('.inpage-cat-pill[data-cat="all"]');
    if (allPill) allPill.classList.add('inpage-cat-pill-active');
    handleFilterChange();
  };

  window.removeSingleFilter = function(name, val) {
    var input = document.querySelector('input[name="' + name + '"][value="' + val + '"]');
    if (input) {
      input.checked = false;
      handleFilterChange();
    }
  };

  window.handleSortChange = function(sortVal) {
    selectedSort = sortVal;
    handleFilterChange();
  };

  window.handleFilterChange = function() {
    var brands = getCheckedValues('brand');
    var usages = getCheckedValues('usage');
    var types = getCheckedValues('type');
    var powers = getCheckedValues('power');
    var prices = getCheckedValues('price');

    updateBadge('badgeBrand', brands.length);
    updateBadge('badgeUsage', usages.length);
    updateBadge('badgeType', types.length);
    updateBadge('badgePower', powers.length);
    updateBadge('badgePrice', prices.length);

    // Render active chips
    renderActiveChips(brands, usages, types, powers, prices);

    var grid = document.getElementById('mainProductGrid');
    if (!grid) return;
    var cards = Array.from(grid.querySelectorAll('.showcase-card-item'));
    var visibleCount = 0;

    cards.forEach(function(card) {
      var cBrand = (card.getAttribute('data-brand') || '').toLowerCase();
      var cUsage = (card.getAttribute('data-usage') || '').toLowerCase();
      var cType = (card.getAttribute('data-type') || '').toLowerCase();
      var cCat = (card.getAttribute('data-cat') || '').toLowerCase();
      var cPrice = parseFloat(card.getAttribute('data-price') || '0');
      var cPowers = (card.getAttribute('data-powers') || '').split(',');

      var matchCat = (activeCategory === 'all') || (cCat === activeCategory) || (cUsage === activeCategory);
      var matchBrand = (brands.length === 0) || brands.includes(cBrand);
      var matchUsage = (usages.length === 0) || usages.includes(cUsage);
      var matchType = (types.length === 0) || types.includes(cType);
      
      var matchPower = true;
      if (powers.length > 0) {
        matchPower = powers.some(function(p) { return cPowers.includes(p); });
      }

      var matchPrice = true;
      if (prices.length > 0) {
        matchPrice = prices.some(function(pr) {
          if (pr === 'under-100') return cPrice < 100;
          if (pr === '100-150') return cPrice >= 100 && cPrice <= 150;
          if (pr === '150-250') return cPrice > 150 && cPrice <= 250;
          if (pr === 'over-250') return cPrice > 250;
          return true;
        });
      }

      if (matchCat && matchBrand && matchUsage && matchType && matchPower && matchPrice) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sorting
    cards.sort(function(a, b) {
      var priceA = parseFloat(a.getAttribute('data-price') || '0');
      var priceB = parseFloat(b.getAttribute('data-price') || '0');
      var titleA = (a.getAttribute('data-title') || '').toLowerCase();
      var titleB = (b.getAttribute('data-title') || '').toLowerCase();

      if (selectedSort === 'price-ascending') return priceA - priceB;
      if (selectedSort === 'price-descending') return priceB - priceA;
      if (selectedSort === 'title-ascending') return titleA.localeCompare(titleB);
      if (selectedSort === 'title-descending') return titleB.localeCompare(titleA);
      return 0;
    });

    cards.forEach(function(card) { grid.appendChild(card); });

    var countDisplay = document.getElementById('inpageProductCount');
    if (countDisplay) {
      countDisplay.textContent = visibleCount + (visibleCount === 1 ? ' product' : ' products');
    }

    var emptyState = document.getElementById('noProductsFoundState');
    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  function renderActiveChips(brands, usages, types, powers, prices) {
    var row = document.getElementById('activeFilterChipsRow');
    var list = document.getElementById('activeChipsList');
    if (!row || !list) return;

    list.innerHTML = '';
    var totalActive = brands.length + usages.length + types.length + powers.length + prices.length;

    if (totalActive === 0) {
      row.style.display = 'none';
      return;
    }

    row.style.display = 'flex';

    function addChip(name, val, label) {
      var chip = document.createElement('span');
      chip.className = 'active-chip';
      chip.innerHTML = label + ' <button type="button" class="chip-remove-btn" onclick="removeSingleFilter(\'' + name + '\', \'' + val + '\')">&times;</button>';
      list.appendChild(chip);
    }

    brands.forEach(function(b) { addChip('brand', b, 'Brand: ' + b.charAt(0).toUpperCase() + b.slice(1)); });
    usages.forEach(function(u) { addChip('usage', u, 'Usage: ' + u.charAt(0).toUpperCase() + u.slice(1)); });
    types.forEach(function(t) { addChip('type', t, 'Type: ' + t.charAt(0).toUpperCase() + t.slice(1)); });
    powers.forEach(function(p) { addChip('power', p, 'Power: ' + p); });
    prices.forEach(function(pr) { addChip('price', pr, 'Price: ' + pr); });
  }

  // Category Pills Listener
  document.querySelectorAll('.inpage-cat-pill').forEach(function(pill) {
    pill.addEventListener('click', function() {
      document.querySelectorAll('.inpage-cat-pill').forEach(function(p) { p.classList.remove('inpage-cat-pill-active'); });
      this.classList.add('inpage-cat-pill-active');
      activeCategory = this.getAttribute('data-cat') || 'all';
      handleFilterChange();
    });
  });

  // URL Query Param Initialization
  var urlParams = new URLSearchParams(window.location.search);
  var brandParam = urlParams.get('brand');
  var catParam = urlParams.get('category');
  var typeParam = urlParams.get('type');

  if (brandParam) {
    var brandInput = document.querySelector('input[name="brand"][value="' + brandParam.toLowerCase() + '"]');
    if (brandInput) brandInput.checked = true;
  }
  if (catParam) {
    var catPill = document.querySelector('.inpage-cat-pill[data-cat="' + catParam.toLowerCase() + '"]');
    if (catPill) {
      document.querySelectorAll('.inpage-cat-pill').forEach(function(p) { p.classList.remove('inpage-cat-pill-active'); });
      catPill.classList.add('inpage-cat-pill-active');
      activeCategory = catParam.toLowerCase();
    }
  }
  if (typeParam) {
    var typeInput = document.querySelector('input[name="usage"][value="' + typeParam.toLowerCase() + '"]');
    if (typeInput) typeInput.checked = true;
    var typeInput2 = document.querySelector('input[name="type"][value="' + typeParam.toLowerCase() + '"]');
    if (typeInput2) typeInput2.checked = true;
  }

  handleFilterChange();
})();
</script>
