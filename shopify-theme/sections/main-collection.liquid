<section class="store-section" style="padding-top: 2.5rem; padding-bottom: 4rem;">
  <div class="store-container">
    <!-- Collection Header -->
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem; border-radius: 9999px; background: #FAF5F2; border: 1px solid #EDE4DE; color: #5c2d76; font-size: 0.78rem; font-weight: 700; margin-bottom: 0.75rem;">
        <span>MOPH Qatar Certified Optical Catalog</span>
      </div>
      <h1 style="font-family: var(--font-sans); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; color: #121212; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
        {{ collection.title | default: "All Optical & Contact Lens Collections" }}
      </h1>
      {% if collection.description != blank %}
        <p style="font-size: 0.95rem; color: #555555; max-width: 600px; margin: 0 auto; line-height: 1.6;">
          {{ collection.description }}
        </p>
      {% else %}
        <p style="font-size: 0.95rem; color: #555555; max-width: 600px; margin: 0 auto; line-height: 1.6;">
          Explore certified medical contact lenses, trend-setting colored lenses, and optical essentials with express same-day Qatar delivery.
        </p>
      {% endif %}
    </div>

    <!-- Category Filter Pills -->
    <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem;">
      <a href="/collections/all" class="cat-pill {% if request.path == '/collections/all' and current_tags == blank %}cat-pill-active{% endif %}">All Products</a>
      <a href="/collections/all?category=medical" class="cat-pill">Medical Lenses</a>
      <a href="/collections/all?category=colored" class="cat-pill">Colour Lenses</a>
      <a href="/collections/all?category=solutions" class="cat-pill">Solutions & Drops</a>
      <a href="/collections/all?category=eyewear" class="cat-pill">Eyeglasses</a>
      <a href="/collections/all?category=sunglasses" class="cat-pill">Sunglasses</a>
    </div>

    <!-- 5-Column Product Grid (Exact Next.js Match) -->
    {% paginate collection.products by 20 %}
      {% if collection.products.size > 0 %}
        <div class="nextjs-products-grid">
          {% for product in collection.products %}
            <div class="nextjs-product-card">
              <a href="{{ product.url }}" class="nextjs-product-link">
                <div class="product-image-box">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="image-placeholder-icon">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                  {% endif %}
                </div>
                <h3 class="product-card-title">{{ product.title }}</h3>
                <span class="product-card-price">{{ product.price | money }}</span>
              </a>
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div style="text-align: center; margin-top: 3rem;">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <!-- Fallback to curated optical products -->
        <div class="nextjs-products-grid">
          <div class="nextjs-product-card">
            <a href="/collections/all?brand=acuvue" class="nextjs-product-link">
              <div class="product-image-box">
                <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="1 Day Acuvue Moist" loading="lazy">
              </div>
              <h3 class="product-card-title">1 Day Acuvue Moist 30 Pack</h3>
              <span class="product-card-price">QAR 159.00</span>
            </a>
          </div>

          <div class="nextjs-product-card">
            <a href="/collections/all?brand=acuvue" class="nextjs-product-link">
              <div class="product-image-box">
                <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="Acuvue Oasys 1 DAY with HydraLuxe" loading="lazy">
              </div>
              <h3 class="product-card-title">Acuvue Oasys 1 DAY with HydraLuxe</h3>
              <span class="product-card-price">QAR 195.00</span>
            </a>
          </div>

          <div class="nextjs-product-card">
            <a href="/collections/all?brand=alcon" class="nextjs-product-link">
              <div class="product-image-box">
                <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500&auto=format&fit=crop" alt="Dailies Total 1" loading="lazy">
              </div>
              <h3 class="product-card-title">Dailies Total 1 (30 Lenses)</h3>
              <span class="product-card-price">QAR 225.00</span>
            </a>
          </div>

          <div class="nextjs-product-card">
            <a href="/collections/all?brand=bella" class="nextjs-product-link">
              <div class="product-image-box">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop" alt="Bella Diamond Gray Shadow" loading="lazy">
              </div>
              <h3 class="product-card-title">Bella Diamond Gray Shadow</h3>
              <span class="product-card-price">QAR 130.00</span>
            </a>
          </div>

          <div class="nextjs-product-card">
            <a href="/collections/all?brand=lensme" class="nextjs-product-link">
              <div class="product-image-box">
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500&auto=format&fit=crop" alt="Lensme Caffe Natural Warm Brown" loading="lazy">
              </div>
              <h3 class="product-card-title">Lensme Caffe Natural Warm Brown</h3>
              <span class="product-card-price">QAR 145.00</span>
            </a>
          </div>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
