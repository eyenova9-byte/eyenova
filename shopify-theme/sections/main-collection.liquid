<style>
  /* Collection Top Banner - STRICT LEFT-ALIGNED (Matches Next.js EyeNova Parity) */
  .shop-banner-clean {
    background: #FFFFFF !important;
    border-bottom: 1px solid #F3F4F6 !important;
    padding: 2.5rem 0 2rem 0 !important;
    margin: 0 !important;
    width: 100% !important;
    text-align: left !important;
  }

  .shop-banner-clean .store-container {
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 0 1.5rem !important;
    text-align: left !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: flex-start !important;
  }

  .shop-page-title {
    font-size: 2rem !important;
    font-weight: 700 !important;
    color: #111827 !important;
    margin: 0 0 0.5rem 0 !important;
    padding: 0 !important;
    letter-spacing: -0.02em !important;
    text-align: left !important;
    line-height: 1.2 !important;
    width: 100% !important;
  }

  .shop-page-subtitle {
    font-size: 0.92rem !important;
    color: #6B7280 !important;
    max-width: 700px !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.5 !important;
    text-align: left !important;
    width: 100% !important;
  }

  .shop-body-container {
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 1.75rem 1.5rem 5rem 1.5rem !important;
    width: 100% !important;
  }

  .nextjs-shop-layout {
    display: flex !important;
    gap: 2.5rem !important;
    align-items: flex-start !important;
    width: 100% !important;
  }

  .nextjs-filter-sidebar {
    width: 250px !important;
    flex-shrink: 0 !important;
    text-align: left !important;
  }

  .nextjs-product-main {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    text-align: left !important;
  }

  /* Product Cards Grid - Exactly matching Home Page */
  .nextjs-product-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 2.25rem 1.5rem !important;
    width: 100% !important;
    align-items: start !important;
  }

  /* Product Card - Clean Minimalist (Same as Home Page) */
  .nextjs-product-grid .nextjs-product-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    width: 100% !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    transition: transform 0.2s ease !important;
  }

  .nextjs-product-grid .nextjs-product-card:hover {
    transform: translateY(-2px) !important;
    border: none !important;
    box-shadow: none !important;
  }

  .nextjs-product-grid .nextjs-product-link {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-decoration: none !important;
    color: inherit !important;
    outline: none !important;
  }

  .nextjs-product-grid .product-image-box {
    width: 100% !important;
    height: 190px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.5rem !important;
    margin-bottom: 0.75rem !important;
    overflow: hidden !important;
    background: transparent !important;
    border-radius: 0 !important;
  }

  .nextjs-product-grid .product-image-box img {
    max-height: 100% !important;
    max-width: 100% !important;
    object-fit: contain !important;
    mix-blend-mode: multiply !important;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .nextjs-product-grid .nextjs-product-link:hover .product-image-box img {
    transform: scale(1.06) !important;
  }

  .nextjs-product-grid .product-card-title {
    font-family: inherit !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #121212 !important;
    line-height: 1.35 !important;
    text-align: center !important;
    margin: 0 0 0.4rem 0 !important;
    padding: 0 0.25rem !important;
    min-height: 38px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .nextjs-product-grid .product-card-price {
    font-family: inherit !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #121212 !important;
    text-align: center !important;
    letter-spacing: 0.04em !important;
  }

  @media (max-width: 1023px) {
    .nextjs-filter-sidebar {
      display: none !important;
    }
    .desktop-sort-row {
      display: none !important;
    }
    .mobile-filter-bar {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      margin-bottom: 1.25rem !important;
      padding-bottom: 0.75rem !important;
      border-bottom: 1px solid #E5E7EB !important;
    }
    .nextjs-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 1.75rem 1rem !important;
    }
    .nextjs-product-grid .product-image-box {
      height: 150px !important;
    }
  }
</style>

<!-- 1. Top Collection Banner -->
<div class="shop-banner-clean">
  <div class="store-container">
    <h1 class="shop-page-title">
      {{ collection.title | default: "Contact Lenses & Eyewear" }}
    </h1>
    <p class="shop-page-subtitle">
      Explore certified medical contact lenses, trend-setting colored lenses, and optical essentials with express same-day Qatar delivery.
    </p>
  </div>
</div>

<!-- 2. Main Collection Body (Exact Next.js Layout Matching User Image) -->
<div class="store-container shop-body-container">

  <!-- Mobile Filter & Sort Bar (< 1024px) -->
  <div class="mobile-filter-bar">
    <button type="button" class="mobile-filter-trigger-btn" onclick="openCollectionMobileFilter()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
      </svg>
      <span>Filter and sort</span>
      <span class="mobile-filter-count-badge" id="mobileFilterTotalBadge" style="display:none;">0</span>
    </button>
    <span class="mobile-product-count-text" id="mobileProductCount">24 products</span>
  </div>

  <!-- Desktop & Tablet Layout (Left Accordion Sidebar + Right Product Grid) -->
  <div class="nextjs-shop-layout">
    
    <!-- LEFT SIDEBAR FILTERS (EXACT EYE-NOVA PARITY FROM SCREENSHOT) -->
    <aside class="nextjs-filter-sidebar" id="CollectionFilterSidebar">
      <!-- Filter Header -->
      <div class="filter-sidebar-header-row">
        <span class="filter-main-title">Filter:</span>
        <button type="button" class="filter-remove-all-cta" id="sidebarRemoveAllBtn" onclick="removeAllFilters()" style="display:none;">
          Remove all
        </button>
      </div>

      <!-- Filter Group 1: Usage (Open by default) -->
      <details class="filter-accordion-item" open id="accordionUsage">
        <summary class="filter-accordion-summary">
          <span class="accordion-title-text">Usage <span class="accordion-count-badge" id="badgeUsageCount"></span></span>
          <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="usage" value="daily" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Daily</span>
          </label>
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="usage" value="monthly" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Monthly</span>
          </label>
        </div>
      </details>

      <!-- Filter Group 2: Type -->
      <details class="filter-accordion-item" id="accordionType">
        <summary class="filter-accordion-summary">
          <span class="accordion-title-text">Type <span class="accordion-count-badge" id="badgeTypeCount"></span></span>
          <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="type" value="standard" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Standard Prescription Lens</span>
          </label>
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="type" value="astigmatism" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Astigmatism Lenses (Toric)</span>
          </label>
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="type" value="multifocal" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Multifocal Lenses</span>
          </label>
          <label class="nextjs-checkbox-label">
            <input type="checkbox" name="type" value="colored" onchange="runFilters()">
            <span class="checkbox-custom"></span>
            <span class="label-text">Colored Lenses</span>
          </label>
        </div>
      </details>

      <!-- Filter Group 3: Power (Scrollable list) -->
      <details class="filter-accordion-item" id="accordionPower">
        <summary class="filter-accordion-summary">
          <span class="accordion-title-text">Power <span class="accordion-count-badge" id="badgePowerCount"></span></span>
          <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content scrollable-options-box">
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="0.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">0.00 (Plano)</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-0.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-0.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-0.75" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-0.75</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-1.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-1.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-1.25" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-1.25</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-1.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-1.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-1.75" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-1.75</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-2.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-2.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-2.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-2.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-3.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-3.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-3.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-3.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-4.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-4.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-4.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-4.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-5.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-5.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-5.50" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-5.50</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-6.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-6.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-7.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-7.00</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="power" value="-8.00" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">-8.00</span></label>
        </div>
      </details>

      <!-- Filter Group 4: Brand (Open by default) -->
      <details class="filter-accordion-item" open id="accordionBrand">
        <summary class="filter-accordion-summary">
          <span class="accordion-title-text">Brand <span class="accordion-count-badge" id="badgeBrandCount"></span></span>
          <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="filter-options-content">
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="acuvue" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Acuvue</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="alcon" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Alcon</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="bella" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Bella</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="amara" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Amara</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="lensme" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">LensMe</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="diva" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Diva</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="coopervision" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">CooperVision</span></label>
          <label class="nextjs-checkbox-label"><input type="checkbox" name="brand" value="bausch" onchange="runFilters()"><span class="checkbox-custom"></span><span class="label-text">Bausch + Lomb</span></label>
        </div>
      </details>
    </aside>

    <!-- RIGHT MAIN PRODUCT GRID -->
    <main class="nextjs-product-main">
      <!-- Top Sort Row -->
      <div class="desktop-sort-row">
        <div class="sort-select-wrapper">
          <label for="SortBySelect" class="sort-by-label">Sort by:</label>
          <div class="sort-select-inner">
            <select id="SortBySelect" class="native-sort-select" onchange="runSort(this.value)">
              <option value="best-selling">Best selling</option>
              <option value="featured">Featured</option>
              <option value="title-ascending">Alphabetically, A-Z</option>
              <option value="title-descending">Alphabetically, Z-A</option>
              <option value="price-ascending">Price, low to high</option>
              <option value="price-descending">Price, high to low</option>
            </select>
            <svg class="sort-select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <span class="desktop-product-count" id="desktopProductCount">24 products</span>
      </div>

      <!-- Active Filter Tags Row -->
      <div class="active-filter-tags-strip" id="activeFilterTagsStrip" style="display:none;">
        <div class="active-tags-container" id="activeTagsContainer"></div>
        <button type="button" class="clear-all-tags-btn" onclick="removeAllFilters()">Clear all</button>
      </div>

      <!-- Product Cards Grid -->
      <div class="nextjs-product-grid" id="mainCollectionGrid">
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <div class="nextjs-product-card" 
                 data-id="{{ product.id }}" 
                 data-brand="{{ product.vendor | downcase }}" 
                 data-title="{{ product.title | escape }}" 
                 data-price="{{ product.price | divided_by: 100.0 }}" 
                 data-usage="{% if product.tags contains 'daily' %}daily{% elsif product.tags contains 'monthly' %}monthly{% endif %}" 
                 data-type="{% if product.tags contains 'astigmatism' %}astigmatism{% elsif product.tags contains 'multifocal' %}multifocal{% elsif product.tags contains 'colored' %}colored{% else %}standard{% endif %}"
                 data-powers="-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
              <a href="{{ product.url }}" class="nextjs-product-link">
                <div class="product-image-box">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="card-placeholder-svg">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                  {% endif %}
                </div>
                <h3 class="product-card-title">{{ product.title }}</h3>
                  <span class="product-card-price">{{ product.price | money }}</span>
              </a>
            </div>
          {% endfor %}
        {% else %}
          <!-- 24 Curated Products from Next.js Retail Catalog -->
          <div class="nextjs-product-card" data-id="p1" data-brand="bella" data-title="Bella Diamond Gray Shadow Contact Lenses" data-price="130" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-0.75,-1.00,-1.25,-1.50,-1.75,-2.00,-2.25,-2.50,-2.75,-3.00,-3.50,-4.00,-4.50,-5.00,-6.00">
            <a href="/collections/all?brand=bella" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop" alt="Bella Diamond Gray Shadow" loading="lazy"></div>
              <h3 class="product-card-title">Bella Diamond Gray Shadow Contact Lenses</h3>
                <span class="product-card-price">QAR 130.00</span>
              </a>
          </div>

          <div class="nextjs-product-card" data-id="p2" data-brand="bella" data-title="Bella Elite Sandy Brown Contact Lenses" data-price="135" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="/collections/all?brand=bella" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=500&auto=format&fit=crop" alt="Bella Elite Sandy Brown" loading="lazy"></div>
              <h3 class="product-card-title">Bella Elite Sandy Brown Contact Lenses</h3>
                <span class="product-card-price">QAR 135.00</span>
              </a>
          </div>

          <div class="nextjs-product-card" data-id="p3" data-brand="lensme" data-title="Lensme Caffe Natural Warm Brown Lenses" data-price="145" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-0.75,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="/collections/all?brand=lensme" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500&auto=format&fit=crop" alt="Lensme Caffe Natural Warm Brown" loading="lazy"></div>
              <h3 class="product-card-title">Lensme Caffe Natural Warm Brown Lenses</h3>
                <span class="product-card-price">QAR 145.00</span>
              </a>
          </div>

          <div class="nextjs-product-card" data-id="p4" data-brand="lensme" data-title="Lensme Caramel Golden Hazel Lenses" data-price="145" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="/collections/all?brand=lensme" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500&auto=format&fit=crop" alt="Lensme Caramel Golden Hazel" loading="lazy"></div>
              <h3 class="product-card-title">Lensme Caramel Golden Hazel Lenses</h3>
                <span class="product-card-price">QAR 145.00</span>
              </a>
          </div>

          <div class="nextjs-product-card" data-id="p5" data-brand="amara" data-title="Amara Toffee Hazel Contact Lenses" data-price="140" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="/collections/all?brand=amara" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=500&auto=format&fit=crop" alt="Amara Toffee Hazel" loading="lazy"></div>
              <h3 class="product-card-title">Amara Toffee Hazel Contact Lenses</h3>
                <span class="product-card-price">QAR 140.00</span>
              </a>
          </div>

          <div class="nextjs-product-card" data-id="p6" data-brand="diva" data-title="Diva Amande Natural Olive Brown Lenses" data-price="150" data-type="colored" data-usage="monthly" data-powers="0.00,-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="/collections/all?brand=diva" class="nextjs-product-link">
              <div class="product-image-box"><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=500&auto=format&fit=crop" alt="Diva Amande Natural Olive Brown" loading="lazy"></div>
              <h3 class="product-card-title">Diva Amande Natural Olive Brown Lenses</h3>
                <span class="product-card-price">QAR 150.00</span>
