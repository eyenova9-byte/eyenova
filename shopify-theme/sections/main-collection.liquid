<script>
  (function() {
    var activeCat = 'all';
    var activeBrand = 'all';
    var sortSelect = document.getElementById('ShowcaseSortBy');
    var countText = document.getElementById('showcaseProductCount');
    var grid = document.getElementById('productGridContainer');
    var emptyState = document.getElementById('noProductsFoundState');
    var resetBtn = document.getElementById('resetShowcaseFiltersBtn');

    var catButtons = document.querySelectorAll('.top-cat-pill');
    catButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        catButtons.forEach(function(b) { b.classList.remove('top-cat-pill-active'); });
        this.classList.add('top-cat-pill-active');
        activeCat = this.getAttribute('data-cat-filter');
        filterAndSort();
      });
    });

    var brandButtons = document.querySelectorAll('.brand-pill');
    brandButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (this.classList.contains('brand-pill-active')) {
          this.classList.remove('brand-pill-active');
          activeBrand = 'all';
        } else {
          brandButtons.forEach(function(b) { b.classList.remove('brand-pill-active'); });
          this.classList.add('brand-pill-active');
          activeBrand = this.getAttribute('data-brand-filter');
        }
        filterAndSort();
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener('change', filterAndSort);
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        activeCat = 'all';
        activeBrand = 'all';
        catButtons.forEach(function(b) { b.classList.remove('top-cat-pill-active'); });
        if (catButtons[0]) catButtons[0].classList.add('top-cat-pill-active');
        brandButtons.forEach(function(b) { b.classList.remove('brand-pill-active'); });
        filterAndSort();
      });
    }

    function filterAndSort() {
      var items = Array.from(document.querySelectorAll('.showcase-card-item'));
      var sortBy = sortSelect ? sortSelect.value : 'best-selling';
      var visibleCount = 0;

      items.forEach(function(item) {
        var itemCat = (item.getAttribute('data-cat') || '').toLowerCase();
        var itemBrand = (item.getAttribute('data-brand') || '').toLowerCase();
        var itemUsage = (item.getAttribute('data-usage') || '').toLowerCase();

        var matchCat = (activeCat === 'all') ||
                       (activeCat === itemCat) ||
                       (activeCat === itemUsage) ||
                       (activeCat === 'daily' && itemUsage === 'daily') ||
                       (activeCat === 'monthly' && itemUsage === 'monthly');

        var matchBrand = (activeBrand === 'all') || (itemBrand.indexOf(activeBrand) !== -1);

        if (matchCat && matchBrand) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      var visibleItems = items.filter(function(i) { return i.style.display !== 'none'; });
      visibleItems.sort(function(a, b) {
        var priceA = parseFloat(a.getAttribute('data-price') || '0');
        var priceB = parseFloat(b.getAttribute('data-price') || '0');
        var titleA = a.getAttribute('data-title') || '';
        var titleB = b.getAttribute('data-title') || '';

        if (sortBy === 'price-ascending') return priceA - priceB;
        if (sortBy === 'price-descending') return priceB - priceA;
        if (sortBy === 'title-ascending') return titleA.localeCompare(titleB);
        if (sortBy === 'title-descending') return titleB.localeCompare(titleA);
        return 0;
      });

      visibleItems.forEach(function(item) { grid.appendChild(item); });

      if (countText) {
        countText.textContent = visibleCount + (visibleCount === 1 ? ' product' : ' products');
      }

      if (emptyState && grid) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
          grid.style.display = 'none';
        } else {
          emptyState.style.display = 'none';
          grid.style.display = 'grid';
        }
      }
    }

    filterAndSort();
  })();
</script>

