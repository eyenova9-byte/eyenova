<!-- =========================================================================== -->
<!-- Mobile Filter Drawer (Exact Next.js Mobile Filter Parity)                  -->
<!-- =========================================================================== -->
<div class="mobile-filter-drawer-overlay" id="mobileFilterOverlay"></div>
<div class="mobile-filter-drawer-panel" id="mobileFilterPanel">
  <div class="mobile-filter-panel-header">
    <h3>Filter and sort</h3>
    <button type="button" id="closeMobileFilterBtn" class="close-mobile-filter-btn" aria-label="Close Filter">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="mobile-filter-panel-body">
    <!-- Sort in mobile -->
    <div class="mobile-filter-section">
      <span class="mobile-filter-section-title">Sort by</span>
      <select id="MobileSortBy" class="mobile-sort-select">
        <option value="best-selling">Best selling</option>
        <option value="featured">Featured</option>
        <option value="title-ascending">Alphabetically, A-Z</option>
        <option value="title-descending">Alphabetically, Z-A</option>
        <option value="price-ascending">Price, low to high</option>
        <option value="price-descending">Price, high to low</option>
      </select>
    </div>

    <!-- Usage in mobile -->
    <div class="mobile-filter-section">
      <span class="mobile-filter-section-title">Usage</span>
      <div class="space-y-2">
        <label class="filter-checkbox-label"><input type="checkbox" name="usageFilter" value="daily" class="filter-checkbox-input"><span>Daily</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="usageFilter" value="monthly" class="filter-checkbox-input"><span>Monthly</span></label>
      </div>
    </div>

    <!-- Brand in mobile -->
    <div class="mobile-filter-section">
      <span class="mobile-filter-section-title">Brand</span>
      <div class="space-y-2">
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="acuvue" class="filter-checkbox-input"><span>Acuvue</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="alcon" class="filter-checkbox-input"><span>Alcon</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="bella" class="filter-checkbox-input"><span>Bella</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="amara" class="filter-checkbox-input"><span>Amara</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="lensme" class="filter-checkbox-input"><span>LensMe</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="diva" class="filter-checkbox-input"><span>Diva</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="coopervision" class="filter-checkbox-input"><span>CooperVision</span></label>
        <label class="filter-checkbox-label"><input type="checkbox" name="brandFilter" value="bausch + lomb" class="filter-checkbox-input"><span>Bausch + Lomb</span></label>
      </div>
    </div>
  </div>

  <div class="mobile-filter-panel-footer">
    <button type="button" id="mobileClearAllBtn" class="mobile-btn-clear">Clear</button>
    <button type="button" id="mobileApplyBtn" class="mobile-btn-apply">Apply</button>
  </div>
</div>

<!-- =========================================================================== -->
<!-- Interactive Client-Side Filter & Sort Engine (No Reloading, Instant Update) -->
<!-- =========================================================================== -->
<script>
  (function() {
    var desktopSort = document.getElementById('ShopSortBy');
    var mobileSort = document.getElementById('MobileSortBy');
    var grid = document.getElementById('productGridContainer');
    var emptyState = document.getElementById('noProductsFoundState');
    var desktopCount = document.getElementById('desktopProductCountText');
    var mobileCount = document.getElementById('mobileProductCountText');
    var removeAllBtn = document.getElementById('removeAllFiltersBtn');
    var mobileClearAll = document.getElementById('mobileClearAllBtn');
    var clearEmptyBtn = document.getElementById('clearEmptyFiltersBtn');
    var mobileFilterCount = document.getElementById('mobileFilterCountBadge');

    // Mobile drawer toggles
    var openMobileFilterBtn = document.getElementById('openMobileFilterBtn');
    var closeMobileFilterBtn = document.getElementById('closeMobileFilterBtn');
    var mobileApplyBtn = document.getElementById('mobileApplyBtn');
    var mobilePanel = document.getElementById('mobileFilterPanel');
    var mobileOverlay = document.getElementById('mobileFilterOverlay');

    function openMobileFilter() {
      if (mobilePanel && mobileOverlay) {
        mobilePanel.classList.add('mobile-filter-open');
        mobileOverlay.classList.add('mobile-filter-overlay-open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeMobileFilter() {
      if (mobilePanel && mobileOverlay) {
        mobilePanel.classList.remove('mobile-filter-open');
        mobileOverlay.classList.remove('mobile-filter-overlay-open');
        document.body.style.overflow = '';
      }
    }

    if (openMobileFilterBtn) openMobileFilterBtn.addEventListener('click', openMobileFilter);
    if (closeMobileFilterBtn) closeMobileFilterBtn.addEventListener('click', closeMobileFilter);
    if (mobileApplyBtn) mobileApplyBtn.addEventListener('click', closeMobileFilter);
    if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileFilter);

    // Sync Sort
    if (desktopSort && mobileSort) {
      desktopSort.addEventListener('change', function() {
        mobileSort.value = this.value;
        runFilterAndSort();
      });
      mobileSort.addEventListener('change', function() {
        desktopSort.value = this.value;
        runFilterAndSort();
      });
    }

    // Attach checkbox events
    var allCheckboxes = document.querySelectorAll('.filter-checkbox-input');
    allCheckboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        // Sync checkboxes with same name and value across desktop/mobile
        var matching = document.querySelectorAll('.filter-checkbox-input[name="' + this.name + '"][value="' + this.value + '"]');
        var isChecked = this.checked;
        matching.forEach(function(m) { m.checked = isChecked; });
        runFilterAndSort();
      });
    });

    function getCheckedValues(name) {
      var arr = [];
      document.querySelectorAll('.filter-checkbox-input[name="' + name + '"]:checked').forEach(function(cb) {
        if (arr.indexOf(cb.value) === -1) arr.push(cb.value);
      });
      return arr;
    }

    function clearAll() {
      allCheckboxes.forEach(function(cb) { cb.checked = false; });
      runFilterAndSort();
    }

    if (removeAllBtn) removeAllBtn.addEventListener('click', clearAll);
    if (mobileClearAll) mobileClearAll.addEventListener('click', clearAll);
    if (clearEmptyBtn) clearEmptyBtn.addEventListener('click', clearAll);

    function runFilterAndSort() {
      var selectedUsages = getCheckedValues('usageFilter');
      var selectedTypes = getCheckedValues('typeFilter');
      var selectedPowers = getCheckedValues('powerFilter');
      var selectedBrands = getCheckedValues('brandFilter');
      var sortBy = desktopSort ? desktopSort.value : 'best-selling';

      var totalActiveFilters = selectedUsages.length + selectedTypes.length + selectedPowers.length + selectedBrands.length;

      // Update badge and remove all button
      if (removeAllBtn) removeAllBtn.style.display = totalActiveFilters > 0 ? 'inline-block' : 'none';
      if (mobileFilterCount) {
        if (totalActiveFilters > 0) {
          mobileFilterCount.style.display = 'inline-block';
          mobileFilterCount.textContent = totalActiveFilters;
        } else {
          mobileFilterCount.style.display = 'none';
        }
      }

      // Update count indicators on sidebar
      var uCount = document.getElementById('usageFilterCount');
      if (uCount) uCount.textContent = selectedUsages.length > 0 ? '(' + selectedUsages.length + ')' : '';
      var tCount = document.getElementById('typeFilterCount');
      if (tCount) tCount.textContent = selectedTypes.length > 0 ? '(' + selectedTypes.length + ')' : '';
      var pCount = document.getElementById('powerFilterCount');
      if (pCount) pCount.textContent = selectedPowers.length > 0 ? '(' + selectedPowers.length + ')' : '';
      var bCount = document.getElementById('brandFilterCount');
      if (bCount) bCount.textContent = selectedBrands.length > 0 ? '(' + selectedBrands.length + ')' : '';

      var items = Array.from(document.querySelectorAll('.showcase-card-item'));
      var visibleCount = 0;

      items.forEach(function(item) {
        var itemBrand = (item.getAttribute('data-brand') || '').toLowerCase();
        var itemUsage = (item.getAttribute('data-usage') || '').toLowerCase();
        var itemType = (item.getAttribute('data-type') || '').toLowerCase();
        var itemPowersRaw = item.getAttribute('data-powers') || '[]';
        var itemPowers = [];
        try { itemPowers = JSON.parse(itemPowersRaw); } catch(e) {}

        var matchUsage = selectedUsages.length === 0 || selectedUsages.indexOf(itemUsage) !== -1;
        var matchType = selectedTypes.length === 0 || selectedTypes.indexOf(itemType) !== -1;
        var matchBrand = selectedBrands.length === 0 || selectedBrands.indexOf(itemBrand) !== -1;
        var matchPower = selectedPowers.length === 0 || selectedPowers.some(function(pow) {
          return itemPowers.indexOf(pow) !== -1;
        });

        if (matchUsage && matchType && matchBrand && matchPower) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Sort items
      var visibleItems = items.filter(function(i) { return i.style.display !== 'none'; });
      visibleItems.sort(function(a, b) {
        var priceA = parseFloat(a.getAttribute('data-price') || '0');
        var priceB = parseFloat(b.getAttribute('data-price') || '0');
        var titleA = a.getAttribute('data-title') || '';
        var titleB = b.getAttribute('data-title') || '';

        if (sortBy === 'price-ascending') return priceA - priceB;
        if (sortBy === 'price-descending') return priceB - priceA;
        if (sortBy === 'title-ascending') return titleA.localeCompare(titleB);
        if (sortBy === 'title-descending') return titleB.localeCompare(titleA);
        return 0;
      });

      // Re-append in sorted order
      visibleItems.forEach(function(item) {
        grid.appendChild(item);
      });

      // Update count text
      var countStr = visibleCount + (visibleCount === 1 ? ' product' : ' products');
      if (desktopCount) desktopCount.textContent = countStr;
      if (mobileCount) mobileCount.textContent = countStr;

      // Empty state
      if (emptyState && grid) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
          grid.style.display = 'none';
        } else {
          emptyState.style.display = 'none';
          grid.style.display = 'grid';
        }
      }
    }

    // Run on initial load
    runFilterAndSort();
  })();
</script>

