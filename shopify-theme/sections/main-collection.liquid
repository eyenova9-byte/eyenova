<!-- Mobile Filter Slideout Drawer -->
<div id="MobileCollectionFilterDrawer" class="mobile-filter-drawer-root" aria-hidden="true">
  <div class="mobile-filter-backdrop" onclick="closeCollectionMobileFilter()"></div>
  <div class="mobile-filter-sheet">
    <div class="mobile-filter-sheet-header">
      <span class="sheet-header-title">Filter and sort</span>
      <button type="button" class="sheet-close-btn" onclick="closeCollectionMobileFilter()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-filter-sheet-body" id="MobileFilterCloneContainer">
      <!-- Cloned accordion filters render here -->
    </div>
    <div class="mobile-filter-sheet-footer">
      <button type="button" class="mobile-filter-clear-all" onclick="removeAllFilters()">Clear all</button>
      <button type="button" class="mobile-filter-apply-btn" onclick="closeCollectionMobileFilter()">Apply Filters</button>
    </div>
  </div>
</div>

<!-- EXACT CLIENT-SIDE ACCORDION FILTER ENGINE -->
<script>
(function() {
  var selectedSort = 'best-selling';

  function getChecked(name) {
    var inputs = document.querySelectorAll('input[name="' + name + '"]:checked');
    var vals = [];
    inputs.forEach(function(i) { vals.push(i.value.toLowerCase()); });
    return vals;
  }

  window.openCollectionMobileFilter = function() {
    var drawer = document.getElementById('MobileCollectionFilterDrawer');
    var cloneContainer = document.getElementById('MobileFilterCloneContainer');
    var sidebar = document.getElementById('CollectionFilterSidebar');
    if (drawer && cloneContainer && sidebar && cloneContainer.children.length === 0) {
      // Clone filters into mobile sheet
      cloneContainer.innerHTML = sidebar.innerHTML;
    }
    if (drawer) {
      drawer.classList.add('active');
      document.body.classList.add('filter-drawer-locked');
    }
  };

  window.closeCollectionMobileFilter = function() {
    var drawer = document.getElementById('MobileCollectionFilterDrawer');
    if (drawer) {
      drawer.classList.remove('active');
      document.body.classList.remove('filter-drawer-locked');
    }
  };

  window.removeAllFilters = function() {
    document.querySelectorAll('.nextjs-shop-layout input[type="checkbox"], .mobile-filter-sheet input[type="checkbox"]').forEach(function(i) {
      i.checked = false;
    });
    runFilters();
  };

  window.removeSingleFilter = function(name, val) {
    document.querySelectorAll('input[name="' + name + '"][value="' + val + '"]').forEach(function(i) {
      i.checked = false;
    });
    runFilters();
  };

  window.runSort = function(sortVal) {
    selectedSort = sortVal;
    runFilters();
  };

  window.runFilters = function() {
    var usages = getChecked('usage');
    var types = getChecked('type');
    var powers = getChecked('power');
    var brands = getChecked('brand');

    var totalActive = usages.length + types.length + powers.length + brands.length;

    // Update Accordion Counts
    updateBadgeText('badgeUsageCount', usages.length);
    updateBadgeText('badgeTypeCount', types.length);
    updateBadgeText('badgePowerCount', powers.length);
    updateBadgeText('badgeBrandCount', brands.length);

    var removeAllBtn = document.getElementById('sidebarRemoveAllBtn');
    if (removeAllBtn) {
      removeAllBtn.style.display = totalActive > 0 ? 'inline-block' : 'none';
    }

    var mobileTotalBadge = document.getElementById('mobileFilterTotalBadge');
    if (mobileTotalBadge) {
      mobileTotalBadge.textContent = totalActive;
      mobileTotalBadge.style.display = totalActive > 0 ? 'inline-flex' : 'none';
    }

    // Render active tags
    renderTags(usages, types, powers, brands);

    // Filter product cards
    var grid = document.getElementById('mainCollectionGrid');
    if (!grid) return;
    var cards = Array.from(grid.querySelectorAll('.nextjs-product-card, .nextjs-card-box'));
    var visibleCount = 0;

    cards.forEach(function(card) {
      var cBrand = (card.getAttribute('data-brand') || '').toLowerCase();
      var cUsage = (card.getAttribute('data-usage') || '').toLowerCase();
      var cType = (card.getAttribute('data-type') || '').toLowerCase();
      var cPowers = (card.getAttribute('data-powers') || '').split(',');

      var matchUsage = (usages.length === 0) || usages.includes(cUsage);
      var matchType = (types.length === 0) || types.includes(cType);
      var matchBrand = (brands.length === 0) || brands.includes(cBrand);

      var matchPower = true;
      if (powers.length > 0) {
        matchPower = powers.some(function(p) { return cPowers.includes(p); });
      }

      if (matchUsage && matchType && matchBrand && matchPower) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards
    cards.sort(function(a, b) {
      var priceA = parseFloat(a.getAttribute('data-price') || '0');
      var priceB = parseFloat(b.getAttribute('data-price') || '0');
      var titleA = (a.getAttribute('data-title') || '').toLowerCase();
      var titleB = (b.getAttribute('data-title') || '').toLowerCase();

      if (selectedSort === 'price-ascending') return priceA - priceB;
      if (selectedSort === 'price-descending') return priceB - priceA;
      if (selectedSort === 'title-ascending') return titleA.localeCompare(titleB);
      if (selectedSort === 'title-descending') return titleB.localeCompare(titleA);
      return 0;
    });

    cards.forEach(function(c) { grid.appendChild(c); });

    var desktopCount = document.getElementById('desktopProductCount');
    var mobileCount = document.getElementById('mobileProductCount');
    var text = visibleCount + (visibleCount === 1 ? ' product' : ' products');
    if (desktopCount) desktopCount.textContent = text;
    if (mobileCount) mobileCount.textContent = text;

    var emptyBox = document.getElementById('noProductsFoundBox');
    if (emptyBox) {
      emptyBox.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  function updateBadgeText(badgeId, count) {
    var b = document.getElementById(badgeId);
    if (!b) return;
    b.textContent = count > 0 ? '(' + count + ')' : '';
  }

  function renderTags(usages, types, powers, brands) {
    var strip = document.getElementById('activeFilterTagsStrip');
    var container = document.getElementById('activeTagsContainer');
    if (!strip || !container) return;

    container.innerHTML = '';
    var total = usages.length + types.length + powers.length + brands.length;
    if (total === 0) {
      strip.style.display = 'none';
      return;
    }
    strip.style.display = 'flex';

    function createTag(name, val, label) {
      var tag = document.createElement('span');
      tag.className = 'active-filter-tag-pill';
      tag.innerHTML = label + ' <button type="button" class="tag-x-btn" onclick="removeSingleFilter(\'' + name + '\', \'' + val + '\')">&times;</button>';
      container.appendChild(tag);
    }

    usages.forEach(function(u) { createTag('usage', u, 'Usage: ' + u.charAt(0).toUpperCase() + u.slice(1)); });
    types.forEach(function(t) { createTag('type', t, 'Type: ' + t.charAt(0).toUpperCase() + t.slice(1)); });
    powers.forEach(function(p) { createTag('power', p, 'Power: ' + p); });
    brands.forEach(function(b) { createTag('brand', b, 'Brand: ' + b.charAt(0).toUpperCase() + b.slice(1)); });
  }

  // Handle URL Params if any
  var params = new URLSearchParams(window.location.search);
  var bParam = params.get('brand');
  var tParam = params.get('type');
  if (bParam) {
    var inp = document.querySelector('input[name="brand"][value="' + bParam.toLowerCase() + '"]');
    if (inp) inp.checked = true;
  }
  if (tParam) {
    var inp2 = document.querySelector('input[name="usage"][value="' + tParam.toLowerCase() + '"]') || document.querySelector('input[name="type"][value="' + tParam.toLowerCase() + '"]');
    if (inp2) inp2.checked = true;
  }

  runFilters();
})();
</script>
