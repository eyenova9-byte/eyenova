<!-- 1. Collection Header -->
<div class="shop-banner-clean">
  <div class="store-container">
    <h1 class="shop-page-title">
      {{ collection.title | default: "All Collections" }}
    </h1>
    <p class="shop-page-subtitle">
      Explore certified medical contact lenses, trend-setting colored lenses, and optical essentials with express same-day Qatar delivery.
    </p>
  </div>
</div>

<!-- 2. IN-PAGE FILTERING SYSTEM FOR LARGE DEVICES (NO SIDEBAR) -->
<div class="store-container shop-body-container">

  <!-- Horizontal Category Navigation Pills -->
  <div class="inpage-cat-pills-wrap">
    <button type="button" class="inpage-cat-pill inpage-cat-pill-active" data-cat="all">All Products</button>
    <button type="button" class="inpage-cat-pill" data-cat="daily">Daily Lenses</button>
    <button type="button" class="inpage-cat-pill" data-cat="monthly">Monthly Lenses</button>
    <button type="button" class="inpage-cat-pill" data-cat="colored">Colour Lenses</button>
    <button type="button" class="inpage-cat-pill" data-cat="astigmatism">Astigmatism (Toric)</button>
    <button type="button" class="inpage-cat-pill" data-cat="multifocal">Multifocal</button>
    <button type="button" class="inpage-cat-pill" data-cat="solutions">Solutions & Drops</button>
    <button type="button" class="inpage-cat-pill" data-cat="eyewear">Eyewear & Shades</button>
  </div>

  <!-- In-Page Filter & Sort Toolbar (On the Page Itself) -->
  <div class="inpage-filter-toolbar" id="InPageFilterToolbar">
    <!-- Left Filter Dropdowns Group -->
    <div class="inpage-filter-group">
      <span class="inpage-filter-heading">Filter:</span>

      <!-- Dropdown 1: Brand -->
      <div class="inpage-dropdown" id="dropdownBrand">
        <button type="button" class="inpage-dropdown-btn" onclick="toggleDropdown('dropdownBrand')">
          <span>Brand</span>
          <span class="inpage-dropdown-badge" id="badgeBrand" style="display:none;">0</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="inpage-dropdown-menu">
          <div class="dropdown-menu-header">
            <span class="dropdown-menu-title">Brands</span>
            <button type="button" class="dropdown-clear-link" onclick="clearGroup('brand')">Reset</button>
          </div>
          <div class="dropdown-menu-body">
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="acuvue" onchange="handleFilterChange()">
              <span>Acuvue</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="alcon" onchange="handleFilterChange()">
              <span>Alcon</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="bella" onchange="handleFilterChange()">
              <span>Bella</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="amara" onchange="handleFilterChange()">
              <span>Amara</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="lensme" onchange="handleFilterChange()">
              <span>LensMe</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="diva" onchange="handleFilterChange()">
              <span>Diva</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="coopervision" onchange="handleFilterChange()">
              <span>CooperVision</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="brand" value="bausch" onchange="handleFilterChange()">
              <span>Bausch + Lomb</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Dropdown 2: Usage / Duration -->
      <div class="inpage-dropdown" id="dropdownUsage">
        <button type="button" class="inpage-dropdown-btn" onclick="toggleDropdown('dropdownUsage')">
          <span>Usage</span>
          <span class="inpage-dropdown-badge" id="badgeUsage" style="display:none;">0</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="inpage-dropdown-menu">
          <div class="dropdown-menu-header">
            <span class="dropdown-menu-title">Usage / Wear</span>
            <button type="button" class="dropdown-clear-link" onclick="clearGroup('usage')">Reset</button>
          </div>
          <div class="dropdown-menu-body">
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="usage" value="daily" onchange="handleFilterChange()">
              <span>Daily Disposable</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="usage" value="monthly" onchange="handleFilterChange()">
              <span>Monthly Wear</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="usage" value="3_months" onchange="handleFilterChange()">
              <span>3 Months</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="usage" value="6_months" onchange="handleFilterChange()">
              <span>6 Months</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Dropdown 3: Lens Type -->
      <div class="inpage-dropdown" id="dropdownType">
        <button type="button" class="inpage-dropdown-btn" onclick="toggleDropdown('dropdownType')">
          <span>Lens Type</span>
          <span class="inpage-dropdown-badge" id="badgeType" style="display:none;">0</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="inpage-dropdown-menu">
          <div class="dropdown-menu-header">
            <span class="dropdown-menu-title">Lens Type</span>
            <button type="button" class="dropdown-clear-link" onclick="clearGroup('type')">Reset</button>
          </div>
          <div class="dropdown-menu-body">
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="type" value="standard" onchange="handleFilterChange()">
              <span>Standard Prescription</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="type" value="astigmatism" onchange="handleFilterChange()">
              <span>Astigmatism Lenses (Toric)</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="type" value="multifocal" onchange="handleFilterChange()">
              <span>Multifocal Lenses</span>
            </label>
            <label class="inpage-checkbox-label">
              <input type="checkbox" name="type" value="colored" onchange="handleFilterChange()">
              <span>Colored Lenses</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Dropdown 4: Prescription Power -->
      <div class="inpage-dropdown" id="dropdownPower">
        <button type="button" class="inpage-dropdown-btn" onclick="toggleDropdown('dropdownPower')">
          <span>Power</span>
          <span class="inpage-dropdown-badge" id="badgePower" style="display:none;">0</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="inpage-dropdown-menu power-dropdown-menu">
          <div class="dropdown-menu-header">
            <span class="dropdown-menu-title">Prescription (SPH)</span>
            <button type="button" class="dropdown-clear-link" onclick="clearGroup('power')">Reset</button>
          </div>
          <div class="dropdown-menu-body power-scroll-list">
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="0.00" onchange="handleFilterChange()"><span>0.00 (Plano)</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-0.50" onchange="handleFilterChange()"><span>-0.50</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-0.75" onchange="handleFilterChange()"><span>-0.75</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-1.00" onchange="handleFilterChange()"><span>-1.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-1.25" onchange="handleFilterChange()"><span>-1.25</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-1.50" onchange="handleFilterChange()"><span>-1.50</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-1.75" onchange="handleFilterChange()"><span>-1.75</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-2.00" onchange="handleFilterChange()"><span>-2.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-2.50" onchange="handleFilterChange()"><span>-2.50</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-3.00" onchange="handleFilterChange()"><span>-3.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-3.50" onchange="handleFilterChange()"><span>-3.50</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-4.00" onchange="handleFilterChange()"><span>-4.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-4.50" onchange="handleFilterChange()"><span>-4.50</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-5.00" onchange="handleFilterChange()"><span>-5.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-6.00" onchange="handleFilterChange()"><span>-6.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-7.00" onchange="handleFilterChange()"><span>-7.00</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="power" value="-8.00" onchange="handleFilterChange()"><span>-8.00</span></label>
          </div>
        </div>
      </div>

      <!-- Dropdown 5: Price Range -->
      <div class="inpage-dropdown" id="dropdownPrice">
        <button type="button" class="inpage-dropdown-btn" onclick="toggleDropdown('dropdownPrice')">
          <span>Price</span>
          <span class="inpage-dropdown-badge" id="badgePrice" style="display:none;">0</span>
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="inpage-dropdown-menu">
          <div class="dropdown-menu-header">
            <span class="dropdown-menu-title">Price (QAR)</span>
            <button type="button" class="dropdown-clear-link" onclick="clearGroup('price')">Reset</button>
          </div>
          <div class="dropdown-menu-body">
            <label class="inpage-checkbox-label"><input type="checkbox" name="price" value="under-100" onchange="handleFilterChange()"><span>Under QAR 100</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="price" value="100-150" onchange="handleFilterChange()"><span>QAR 100 - 150</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="price" value="150-250" onchange="handleFilterChange()"><span>QAR 150 - 250</span></label>
            <label class="inpage-checkbox-label"><input type="checkbox" name="price" value="over-250" onchange="handleFilterChange()"><span>Over QAR 250</span></label>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Sort & Count Group -->
    <div class="inpage-sort-group">
      <div class="inpage-sort-wrap">
        <label for="InPageSortBy" class="inpage-sort-label">Sort by:</label>
        <select id="InPageSortBy" class="inpage-sort-select" onchange="handleSortChange(this.value)">
          <option value="best-selling">Best selling</option>
          <option value="featured">Featured</option>
          <option value="title-ascending">Alphabetically, A-Z</option>
          <option value="title-descending">Alphabetically, Z-A</option>
          <option value="price-ascending">Price, low to high</option>
          <option value="price-descending">Price, high to low</option>
        </select>
        <svg class="sort-chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <span class="inpage-count-display" id="inpageProductCount">24 products</span>
    </div>
  </div>

  <!-- Active Filter Badges Bar (Removable Pills) -->
  <div class="active-filter-chips-row" id="activeFilterChipsRow" style="display:none;">
    <span class="active-filters-label">Active filters:</span>
    <div class="active-chips-list" id="activeChipsList"></div>
    <button type="button" class="clear-all-chips-btn" onclick="clearAllFilters()">Clear all</button>
  </div>

  <!-- Full-Width 4-Column Product Grid (NO CRAMPED SIDEBAR) -->
  <div class="full-showcase-grid-wrap">
    <div class="full-showcase-grid" id="mainProductGrid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <div class="showcase-card-item" 
               data-id="{{ product.id }}" 
               data-brand="{{ product.vendor | downcase }}" 
               data-title="{{ product.title | escape }}" 
               data-price="{{ product.price | divided_by: 100.0 }}" 
               data-usage="{% if product.tags contains 'daily' %}daily{% elsif product.tags contains 'monthly' %}monthly{% endif %}" 
               data-type="{% if product.tags contains 'astigmatism' %}astigmatism{% elsif product.tags contains 'multifocal' %}multifocal{% elsif product.tags contains 'colored' %}colored{% else %}standard{% endif %}"
               data-cat="{% if product.tags contains 'colored' %}colored{% elsif product.tags contains 'solutions' %}solutions{% elsif product.tags contains 'eyewear' %}eyewear{% elsif product.tags contains 'daily' %}daily{% elsif product.tags contains 'monthly' %}monthly{% else %}medical{% endif %}"
               data-powers="-0.50,-1.00,-1.50,-2.00,-2.50,-3.00,-3.50,-4.00,-5.00">
            <a href="{{ product.url }}" class="nextjs-product-link">
              <div class="product-image-box">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
                {% else %}
                  <div class="image-placeholder-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5c2d76" stroke-width="1.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  </div>
                {% endif %}
              </div>
              <h3 class="product-card-title">{{ product.title }}</h3>
              <span class="product-card-price">{{ product.price | money }}</span>
            </a>
          </div>
        {% endfor %}
