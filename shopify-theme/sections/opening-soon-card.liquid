<section id="opening-soon" class="store-section" data-reveal>
  <div class="store-container">
    <div class="opening-soon-luxury-card">
      <div class="luxury-aura-top-right"></div>
      <div class="luxury-aura-bottom-left"></div>

      <div class="opening-soon-content">
        <div class="opening-soon-pill">
          <span class="pill-ping-dot"></span>
          <span>Opening Soon in Qatar</span>
        </div>

        <h2 class="opening-soon-title">EyeNova &mdash; Opening Soon in Qatar</h2>

        <p class="opening-soon-desc">
          We are preparing to launch Qatar's premier optical destination for certified medical & colored contact lenses and luxury eyewear, with express delivery across all Qatar municipalities.
        </p>

        <div class="opening-soon-value-grid">
          <div class="value-mini-card">
            <h4>100% Certified Authentic</h4>
            <p>Authorized global optical brands</p>
          </div>
          <div class="value-mini-card">
            <h4>Express Delivery Across Qatar</h4>
            <p>Doha & all municipalities</p>
          </div>
          <div class="value-mini-card">
            <h4>Personalized Concierge</h4>
            <p>Direct optical guidance</p>
          </div>
        </div>

        <div class="opening-soon-cta">
          <a href="https://wa.me/97455123456" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-concierge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
            </svg>
            <span>WhatsApp Inquiries & Early Access</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Opening Soon Card",
  "settings": [],
  "presets": [
    {
      "name": "Opening Soon Card"
    }
  ]
}
{% endschema %}
