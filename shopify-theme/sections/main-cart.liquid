<section class="main-cart-section" data-reveal style="padding: 4rem 2rem; max-width: 900px; margin: 0 auto;">
  <h1 style="font-family: var(--font-serif); font-size: 2.5rem; color: var(--color-primary); margin-bottom: 2rem; text-align: center;">
    {{ 'cart.title' | t }}
  </h1>

  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" id="cart">
      <div style="background: #ffffff; border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-subtle);">
        {% for item in cart.items %}
          <div style="display: flex; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--color-border); align-items: center;">
            <img src="{{ item.image | img_url: '160x160', crop: 'center' }}" alt="{{ item.title }}" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
            <div style="flex-grow: 1;">
              <h3 style="font-size: 1.1rem; color: var(--color-text); margin-bottom: 0.35rem;">{{ item.product.title }}</h3>
              <p style="font-size: 1rem; color: var(--color-primary); font-weight: 700;">
                {{ item.final_line_price | money_without_trailing_zeros }} {{ 'general.currency' | t }}
              </p>

              {% if item.properties.size > 0 %}
                <div style="font-size: 0.8rem; color: var(--color-muted); margin-top: 0.5rem; background: #fdfbf7; padding: 0.5rem 0.75rem; border-radius: 4px;">
                  {% for prop in item.properties %}
                    <div><strong>{{ prop.first }}:</strong> {{ prop.last }}</div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            <div style="text-align: right;">
              <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #dc2626; font-size: 0.85rem; text-decoration: none;">
                Remove
              </a>
            </div>
          </div>
        {% endfor %}

        <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; font-size: 1.3rem; font-weight: 700;">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span style="color: var(--color-primary);">{{ cart.total_price | money_without_trailing_zeros }} {{ 'general.currency' | t }}</span>
        </div>

        <p style="font-size: 0.85rem; color: var(--color-muted); margin-top: 0.5rem; margin-bottom: 2rem;">
          {{ 'cart.shipping_note' | t }}
        </p>

        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
          <a href="/collections/all" class="btn btn-outline">
            {{ 'general.continue_shopping' | t }}
          </a>
          <button type="submit" name="checkout" class="btn btn-primary" style="padding: 1rem 2.5rem;">
            {{ 'general.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 6rem 2rem; background: #ffffff; border-radius: 12px; border: 1px solid var(--color-border);">
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-muted);">{{ 'general.empty_cart' | t }}</h2>
      <a href="/collections/all" class="btn btn-primary" style="padding: 1rem 2.5rem;">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
