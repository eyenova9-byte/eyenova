<section class="store-section" data-reveal>
  <div class="store-container">
    <div class="section-title-row">
      <h2 class="section-title-text">Contact Lenses</h2>
      <a href="/collections/all?category=medical" class="section-link-more">View all &rarr;</a>
    </div>

    <!-- Scrollable Single Row Container -->
    <div id="contactLensScroll" class="nextjs-circle-scroll-track">
      <!-- 1. Daily Lens -->
      <a href="/collections/all?type=daily" class="nextjs-circle-item" data-reveal data-reveal-delay="1">
        <div class="nextjs-circle-frame" style="background-color: #FFF9E6; border-color: #F5E7B8;">
          <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=350&auto=format&fit=crop" alt="Daily Lens" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Daily Lens</span>
      </a>

      <!-- 2. Monthly Lens -->
      <a href="/collections/all?type=monthly" class="nextjs-circle-item" data-reveal data-reveal-delay="2">
        <div class="nextjs-circle-frame" style="background-color: #EEF2FF; border-color: #D6E0FF;">
          <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=350&auto=format&fit=crop" alt="Monthly Lens" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Monthly Lens</span>
      </a>

      <!-- 3. Color Lenses -->
      <a href="/collections/all?category=colored" class="nextjs-circle-item" data-reveal data-reveal-delay="3">
        <div class="nextjs-circle-frame" style="background-color: #FFF1F2; border-color: #FFE0E3;">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=350&auto=format&fit=crop" alt="Color Lenses" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Color Lenses</span>
      </a>

      <!-- 4. Astigmatism -->
      <a href="/collections/all?type=astigmatism" class="nextjs-circle-item" data-reveal data-reveal-delay="4">
        <div class="nextjs-circle-frame" style="background-color: #E6FFFA; border-color: #B2F5EA;">
          <img src="https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=350&auto=format&fit=crop" alt="Astigmatism" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Astigmatism</span>
      </a>

      <!-- 5. Multi-Focal -->
      <a href="/collections/all?type=multifocal" class="nextjs-circle-item" data-reveal data-reveal-delay="5">
        <div class="nextjs-circle-frame" style="background-color: #F3E8FF; border-color: #E9D5FF;">
          <img src="https://images.unsplash.com/photo-1591076482161-42ce6da69f67?w=350&auto=format&fit=crop" alt="Multi-Focal" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Multi-Focal</span>
      </a>

      <!-- 6. Solutions -->
      <a href="/collections/all?category=solutions" class="nextjs-circle-item" data-reveal data-reveal-delay="5">
        <div class="nextjs-circle-frame" style="background-color: #F0F9FF; border-color: #BAE6FD;">
          <img src="https://images.unsplash.com/photo-1607613009820-a29f7bb81c04?w=350&auto=format&fit=crop" alt="Solutions" loading="lazy">
        </div>
        <span class="nextjs-circle-label">Solutions</span>
      </a>
    </div>

    <!-- Bottom Left & Right Scroll Controls -->
    <div class="nextjs-scroll-controls">
      <button type="button" class="nextjs-nav-arrow" onclick="document.getElementById('contactLensScroll').scrollBy({left: -260, behavior: 'smooth'})" aria-label="Scroll left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="nextjs-nav-arrow" onclick="document.getElementById('contactLensScroll').scrollBy({left: 260, behavior: 'smooth'})" aria-label="Scroll right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Lens Hubs",
  "settings": [],
  "presets": [
    {
      "name": "Contact Lens Hubs"
    }
  ]
}
{% endschema %}
