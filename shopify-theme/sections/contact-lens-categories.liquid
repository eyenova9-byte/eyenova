<section class="section-container" style="padding-top: 3.5rem; padding-bottom: 2rem;">
  <div class="section-header-flex">
    <h2 class="section-heading-clean">Contact Lenses</h2>
    <a href="/collections/all?category=medical" class="section-link-accent">View all &rarr;</a>
  </div>

  <div class="horizontal-scroll-wrapper">
    <div id="contactLensScroll" class="horizontal-scroll-track">
      <!-- Daily Lens -->
      <a href="/collections/all?type=daily" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #FFF9E6; border-color: #F5E7B8;">
          <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=350&auto=format&fit=crop" alt="Daily Lens" loading="lazy">
        </div>
        <span class="circle-cat-label">Daily Lens</span>
      </a>

      <!-- Monthly Lens -->
      <a href="/collections/all?type=monthly" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #EEF2FF; border-color: #D6E0FF;">
          <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=350&auto=format&fit=crop" alt="Monthly Lens" loading="lazy">
        </div>
        <span class="circle-cat-label">Monthly Lens</span>
      </a>

      <!-- Color Lenses -->
      <a href="/collections/all?category=colored" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #FFF1F2; border-color: #FFE0E3;">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=350&auto=format&fit=crop" alt="Color Lenses" loading="lazy">
        </div>
        <span class="circle-cat-label">Color Lenses</span>
      </a>

      <!-- Astigmatism -->
      <a href="/collections/all?type=astigmatism" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #E6FFFA; border-color: #B2F5EA;">
          <img src="https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=350&auto=format&fit=crop" alt="Astigmatism" loading="lazy">
        </div>
        <span class="circle-cat-label">Astigmatism</span>
      </a>

      <!-- Multi-Focal -->
      <a href="/collections/all?type=multifocal" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #F3E8FF; border-color: #E9D5FF;">
          <img src="https://images.unsplash.com/photo-1591076482161-42ce6da69f67?w=350&auto=format&fit=crop" alt="Multi-Focal" loading="lazy">
        </div>
        <span class="circle-cat-label">Multi-Focal</span>
      </a>

      <!-- Solutions -->
      <a href="/collections/all?category=solutions" class="circle-cat-card">
        <div class="circle-avatar" style="background-color: #F0F9FF; border-color: #BAE6FD;">
          <img src="https://images.unsplash.com/photo-1607613009820-a29f7bb81c04?w=350&auto=format&fit=crop" alt="Solutions" loading="lazy">
        </div>
        <span class="circle-cat-label">Solutions</span>
      </a>
    </div>

    <!-- Scroll controls -->
    <div class="scroll-buttons-center">
      <button type="button" class="scroll-arrow-btn" onclick="document.getElementById('contactLensScroll').scrollBy({left: -260, behavior: 'smooth'})" aria-label="Scroll left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="scroll-arrow-btn" onclick="document.getElementById('contactLensScroll').scrollBy({left: 260, behavior: 'smooth'})" aria-label="Scroll right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Lens Hubs",
  "settings": [],
  "presets": [
    {
      "name": "Contact Lens Hubs"
    }
  ]
}
{% endschema %}
